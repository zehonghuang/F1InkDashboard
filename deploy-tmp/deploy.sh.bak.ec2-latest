#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
ROOT="$(pwd)"
LOG_DIR="$ROOT/logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/deploy-$(date +%Y%m%d-%H%M%S).log"
touch "$LOG"
echo "== deploy start $(date) ==" > "$LOG" 2>&1

TS() { date '+%Y-%m-%d %H:%M:%S'; }
log()  { echo "[$(TS)] $*" | tee -a "$LOG"; }
die()  { log "ERROR: $*"; exit 1; }

if docker compose version >/dev/null 2>&1; then DC="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then DC="docker-compose"
else die "Neither 'docker compose' nor 'docker-compose' available"; fi
log "Using docker:        $(command -v docker)"
log "Using docker-compose:$(command -v $DC)"

[ -f "$ROOT/.env" ] || die ".env not found at $ROOT/.env"
set -a
# shellcheck disable=SC1091
source "$ROOT/.env"
set +a
: "${GITHUB_REPO:=zehonghuang/F1InkDashboard}"
: "${GITHUB_BRANCH:=main}"
: "${GATEWAY_DOMAIN:=f1ink.normal-person.icu}"

log "============================================================"
log "Starting deployment of $GITHUB_REPO (branch: $GITHUB_BRANCH)"
log "============================================================"

log "Fetching source code..."
SRC_DIR="$ROOT/src"
mkdir -p "$SRC_DIR"
pushd "$SRC_DIR" >/dev/null 2>&1
GIT_URL="https://github.com/${GITHUB_REPO}.git"
if gh auth status >/dev/null 2>&1; then
  log "(gh) Using authenticated gh for repo access"
  if [ -d .git ]; then
    gh repo sync "$GITHUB_REPO" --branch "$GITHUB_BRANCH" --force >/dev/null 2>&1 || true
    git fetch --all --prune --depth 50 >>"$LOG" 2>&1
    git checkout "$GITHUB_BRANCH" >>"$LOG" 2>&1
    git reset --hard "origin/$GITHUB_BRANCH" >>"$LOG" 2>&1
  else
    gh repo clone "$GITHUB_REPO" . -- --branch "$GITHUB_BRANCH" --single-branch --depth 50 >>"$LOG" 2>&1
  fi
else
  log "(git) Using HTTPS git clone/pull: $GIT_URL"
  if [ -d .git ]; then
    git remote set-url origin "$GIT_URL" 2>/dev/null || true
    git fetch origin "$GITHUB_BRANCH" --prune --depth 50 >>"$LOG" 2>&1
    git checkout "$GITHUB_BRANCH" >>"$LOG" 2>&1
    git reset --hard "origin/$GITHUB_BRANCH" >>"$LOG" 2>&1
  else
    git clone --branch "$GITHUB_BRANCH" --single-branch --depth 50 "$GIT_URL" . >>"$LOG" 2>&1
  fi
fi
HEAD="$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
SUBJ="$(git log -1 --pretty=%s 2>/dev/null || echo '')"
log "Source code ready. Commit: $HEAD $SUBJ"
popd >/dev/null 2>&1

log "Checking Dockerfiles & configs ..."
for d in backend admin admin-v2 charts; do
  [ -f "$ROOT/src/$d/Dockerfile" ] || die "Missing Dockerfile: src/$d/Dockerfile"
done
[ -f "$ROOT/nginx/conf.d/default.conf" ] || die "Missing nginx config: nginx/conf.d/default.conf"
[ -f "$ROOT/docker-compose.yml" ]     || die "Missing docker-compose.yml"

log "Stopping old containers ..."
$DC -f "$ROOT/docker-compose.yml" --env-file "$ROOT/.env" config >/dev/null \
  || die "docker-compose config validation failed"

log "Building images ..."
$DC -f "$ROOT/docker-compose.yml" --env-file "$ROOT/.env" build \
  2>&1 | tee -a "$LOG" | tail -n 40

log "Reloading nginx config + starting containers ..."
$DC -f "$ROOT/docker-compose.yml" --env-file "$ROOT/.env" up -d \
  2>&1 | tee -a "$LOG" | tail -n 30

# nginx 配置挂载后做一次容器内 nginx -s reload（可选，但保险）
docker exec f1ink-nginx-gateway nginx -s reload 2>/dev/null \
  || log "(warning: f1ink-nginx-gateway nginx reload skipped / not yet running)"

# ===== Smoke =====
# 策略：HTTPS 对 $GATEWAY_DOMAIN 用 --resolve 强制走 127.0.0.1，加 -k 忽略自签/证书验证路径问题，
#       从而测到真实「443 server { ... }」配置，不会被 80 端口 301 跳转干扰。
log "Smoke testing (HTTPS --resolve $GATEWAY_DOMAIN:443:127.0.0.1 -k) ..."
CSMOKE="curl -sk --max-time 10 --resolve ${GATEWAY_DOMAIN}:443:127.0.0.1 -o /dev/null -w"
ck() { local p="$1"; local expect="${2:-^[234][0-9][0-9]$}"; local c; c=$($CSMOKE '%{http_code}' "https://${GATEWAY_DOMAIN}${p}"); echo "  $p -> $c"; [[ "$c" =~ $expect ]]; }
(ck /api/v1/health '^[234][0-9][0-9]$') || true
(ck /admin/         '^[23][0-9][0-9]$') || die "/admin/ smoke failed"
(ck /admin-v2/      '^[23][0-9][0-9]$') || die "/admin-v2/ smoke failed"
(ck /charts/        '^[23][0-9][0-9]$') || die "/charts/ smoke failed"
(ck /               '^[23][0-9][0-9]$') || true
(ck /ws/motorsport/live '^101|4[0-9][0-9]|5[0-9][0-9]$') || true

log "External HTTPS smoke (real DNS, optional) ..."
curl -sS --max-time 10 -o /dev/null -w '  HTTPS /admin-v2/ -> %{http_code}\n' "https://$GATEWAY_DOMAIN/admin-v2/" 2>&1 | tee -a "$LOG" || true
curl -sS --max-time 10 -o /dev/null -w '  HTTPS /         -> %{http_code}\n' "https://$GATEWAY_DOMAIN/"         2>&1 | tee -a "$LOG" || true

log "============================================================"
log "Deployment OK. log = $LOG"
log "============================================================"
