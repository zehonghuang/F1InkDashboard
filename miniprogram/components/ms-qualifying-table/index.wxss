.msqt {
  background: #0f141b;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.25);
}

.msqt-header {
  padding: 28rpx 28rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.msqt-title {
  font-size: 40rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
}

.msqt-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.msqt-actions-label {
  font-size: 24rpx;
  color: rgba(148, 163, 184, 0.9);
}

.msqt-switch {
  transform: scale(0.8);
}

.msqt-scroll {
  padding: 0 16rpx 20rpx;
  box-sizing: border-box;
}

.msqt-table {
  width: 1220rpx;
}

.msqt-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.msqt-row:not(.msqt-head) {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  overflow: hidden;
}

.msqt-head {
  margin-top: 0;
  padding: 10rpx 0;
}

.msqt-head .msqt-cell {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(148, 163, 184, 0.95);
}

.msqt-cell {
  padding: 18rpx 14rpx;
  box-sizing: border-box;
  flex: none;
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.95);
  text-align: center;
}

.msqt-c-cla {
  width: 90rpx;
}

.msqt-c-driver {
  width: 300rpx;
  text-align: left;
  border-right: 1rpx solid rgba(148, 163, 184, 0.12);
}

.msqt-c-no {
  width: 110rpx;
}

.msqt-c-car {
  width: 210rpx;
  border-right: 1rpx solid rgba(148, 163, 184, 0.12);
}

.msqt-c-laps {
  width: 100rpx;
}

.msqt-c-time {
  width: 170rpx;
}

.msqt-c-int {
  width: 150rpx;
}

.msqt-c-tyre {
  width: 90rpx;
}

.msqt-cla {
  width: 52rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: rgba(15, 23, 42, 0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 800;
  margin: 0 auto;
}

.msqt-driver-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.msqt-team-badge {
  width: 8rpx;
  height: 34rpx;
  transform: skewX(-12deg);
  border-radius: 2rpx;
  flex: none;
}

.msqt-driver {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.msqt-team {
  font-size: 22rpx;
  margin-top: 4rpx;
  color: rgba(148, 163, 184, 0.9);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.msqt-no {
  width: 58rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: rgba(15, 23, 42, 0.65);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 800;
  margin: 0 auto;
}

.msqt-car {
  --car-accent: #64748b;
  height: 44rpx;
  width: 168rpx;
  border-radius: 9999rpx;
  margin: 0 auto;
  background:
    linear-gradient(90deg, rgba(15, 23, 42, 0.2), rgba(15, 23, 42, 0.75)),
    radial-gradient(closest-side at 20% 50%, rgba(255, 255, 255, 0.15), rgba(0, 0, 0, 0) 70%),
    linear-gradient(90deg, var(--car-accent), rgba(255, 255, 255, 0));
  opacity: 0.95;
}

.msqt-gap {
  font-weight: 800;
  line-height: 1;
}

.msqt-time {
  margin-top: 6rpx;
  font-weight: 800;
  line-height: 1;
}

.msqt-tyre {
  width: 36rpx;
  height: 36rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  font-weight: 800;
}
