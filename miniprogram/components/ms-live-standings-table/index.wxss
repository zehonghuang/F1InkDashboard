.mslt {
  background: #141a24;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.25);
}

.mslt-header {
  padding: 20rpx 24rpx 12rpx;
}

.mslt-title {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(148, 163, 184, 0.95);
}

.mslt-frame {
  margin: 0 12rpx 12rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.mslt-scroll {
  padding: 0 12rpx 12rpx;
  box-sizing: border-box;
}

.mslt-table {
  width: 940rpx;
}

.mslt-row {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  will-change: transform;
  transform-origin: center center;
}

.mslt-row:not(.mslt-head) {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  overflow: hidden;
  transition: background-color 620ms ease, box-shadow 620ms ease, transform 620ms ease;
}

.mslt-data-row {
  position: relative;
  z-index: 1;
}

.mslt-data-row.mslt-row-rise {
  z-index: 3;
  background: linear-gradient(90deg, rgba(34, 197, 94, 0.12), rgba(255, 255, 255, 0.05));
  box-shadow: 0 10rpx 24rpx rgba(34, 197, 94, 0.14);
}

.mslt-data-row.mslt-row-fall {
  z-index: 3;
  background: linear-gradient(90deg, rgba(239, 68, 68, 0.11), rgba(255, 255, 255, 0.05));
  box-shadow: 0 10rpx 24rpx rgba(239, 68, 68, 0.12);
}

.mslt-head {
  margin-top: 0;
  padding: 8rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #141a24;
}

.mslt-cell {
  box-sizing: border-box;
  flex: none;
  padding: 8rpx 4rpx;
  text-align: center;
  font-size: 18rpx;
  color: rgba(226, 232, 240, 0.96);
}

.mslt-head .mslt-cell {
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(148, 163, 184, 0.95);
}

.mslt-c-pos {
  width: 64rpx;
}

.mslt-c-driver {
  width: 190rpx;
  text-align: left;
  padding-left: 8rpx;
}

.mslt-c-gap {
  width: 96rpx;
}

.mslt-c-time {
  width: 96rpx;
  padding-left: 2rpx;
  padding-right: 2rpx;
}

.mslt-c-tyre {
  width: 164rpx;
  padding-left: 2rpx;
  padding-right: 2rpx;
}

.mslt-c-sectors {
  width: 330rpx;
  padding-left: 8rpx;
  padding-right: 4rpx;
  text-align: left;
}

.mslt-pos-box {
  width: 46rpx;
  height: 38rpx;
  border-radius: 10rpx;
  background: rgba(15, 23, 42, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  margin: 0 auto;
  transition: background-color 620ms ease, color 620ms ease, box-shadow 620ms ease, border-color 620ms ease, transform 620ms ease;
}

.mslt-pos-box.mslt-move-up {
  background: rgba(34, 197, 94, 0.14);
  border-color: rgba(34, 197, 94, 0.55);
  color: #bbf7d0;
  box-shadow: inset 0 0 0 1rpx rgba(34, 197, 94, 0.18), 0 6rpx 14rpx rgba(34, 197, 94, 0.14);
}

.mslt-pos-box.mslt-move-down {
  background: rgba(239, 68, 68, 0.12);
  border-color: rgba(239, 68, 68, 0.52);
  color: #fecaca;
  box-shadow: inset 0 0 0 1rpx rgba(239, 68, 68, 0.16), 0 6rpx 14rpx rgba(239, 68, 68, 0.12);
}

.mslt-driver-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mslt-driver-accent {
  width: 6rpx;
  height: 28rpx;
  transform: skewX(-12deg);
  border-radius: 2rpx;
  flex: none;
}

.mslt-driver-text {
  min-width: 0;
}

.mslt-driver {
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #f8fafc;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mslt-team {
  margin-top: 2rpx;
  font-size: 16rpx;
  line-height: 1.2;
  color: #94a3b8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mslt-time {
  font-weight: 800;
  font-size: 16rpx;
  line-height: 1.1;
}

.mslt-tyre-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-wrap: wrap;
}

.mslt-tyre-badge {
  min-width: 20px;
  height: 20px;
  padding: 0 8rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #e2e8f0;
  font-size: 16rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.mslt-tyre-meta {
  color: #94a3b8;
  font-size: 14rpx;
  line-height: 1;
  font-weight: 600;
  white-space: nowrap;
}

.mslt-sectors-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
}

.mslt-sector {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 4rpx;
  min-width: 0;
}

.mslt-sector-chip {
  height: 20rpx;
  padding: 0 4rpx;
  border-radius: 4rpx;
  background: transparent;
  color: #94a3b8;
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  line-height: 1;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.mslt-sc-purple {
  background: transparent;
  color: #e9d5ff;
  text-shadow: 0 0 8rpx rgba(192, 132, 252, 0.45);
}

.mslt-sc-yellow {
  background: transparent;
  color: #fde68a;
  text-shadow: 0 0 8rpx rgba(250, 204, 21, 0.45);
}

.mslt-sc-green {
  background: transparent;
  color: #86efac;
  text-shadow: 0 0 8rpx rgba(74, 222, 128, 0.45);
}

.mslt-segment-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 3rpx;
}

.mslt-segment-row--placeholder {
  opacity: 0.38;
}

.mslt-segment-bar {
  width: 8rpx;
  height: 22rpx;
  border-radius: 3rpx;
  background: rgba(148, 163, 184, 0.32);
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.03) inset;
}

.mslt-segment-bar--ph {
  opacity: 0.42;
}

.mslt-sd-purple {
  background: linear-gradient(180deg, #d8b4fe 0%, #a855f7 100%);
  box-shadow: 0 0 8rpx rgba(192, 132, 252, 0.75), inset 0 0 0 1rpx rgba(244, 114, 182, 0.12);
}

.mslt-sd-yellow {
  background: linear-gradient(180deg, #fde68a 0%, #eab308 100%);
  box-shadow: 0 0 8rpx rgba(250, 204, 21, 0.75), inset 0 0 0 1rpx rgba(254, 240, 138, 0.16);
}

.mslt-sd-blue {
  background: linear-gradient(180deg, #93c5fd 0%, #3b82f6 100%);
  box-shadow: 0 0 8rpx rgba(96, 165, 250, 0.75), inset 0 0 0 1rpx rgba(147, 197, 253, 0.14);
}

.mslt-sd-green {
  background: linear-gradient(180deg, #86efac 0%, #22c55e 100%);
  box-shadow: 0 0 8rpx rgba(74, 222, 128, 0.75), inset 0 0 0 1rpx rgba(134, 239, 172, 0.15);
}
