.card {
  margin: 0 32rpx;
  font-size: 28rpx;
  overflow: hidden;
  position: relative;
  background: #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 10rpx;
}

.card-full {
  margin: 0;
  border-left: none;
  border-right: none;
  border-radius: 0;
}

.header {
  display: flex;
  padding: 24rpx 32rpx;
  align-items: center;
  gap: 16rpx;
}

.thumb {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 auto;
}

.title {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.extra {
  flex: 0 0 auto;
  color: rgba(255, 255, 255, 0.75);
}

.body {
  position: relative;
  padding: 24rpx 32rpx;
  color: rgba(255, 255, 255, 0.86);
}

.body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  transform: scale(0.5);
  transform-origin: 0 0;
  pointer-events: none;
  box-sizing: border-box;
  border: 0 solid rgba(255, 255, 255, 0.12);
  border-top-width: 1px;
}

.footer {
  display: none;
}
