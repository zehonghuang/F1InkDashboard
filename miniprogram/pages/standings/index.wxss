.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tabs {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin: 12rpx 0 10rpx 0;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 700;
}

.tab-active {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

.hint {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  padding: 0 6rpx;
  margin-bottom: 12rpx;
}

.error {
  color: rgba(255, 120, 120, 0.9);
  font-size: 24rpx;
  padding: 0 6rpx;
  margin-bottom: 12rpx;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.card-left {
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.driver {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.team {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-right {
  width: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 0;
}

.pts {
  color: rgba(255, 255, 255, 0.9);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}
