.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.14) 0, rgba(225, 6, 0, 0) 32%),
    linear-gradient(180deg, #15151e 0%, #101018 56%, #09090f 100%);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.tabs {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  margin: 14rpx 0 16rpx 0;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 7, 12, 0.88);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.62);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.tab-active {
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.2) 0%, rgba(225, 6, 0, 0.12) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(225, 6, 0, 0.22);
  color: #ffffff;
}

.leaders {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.leader-card {
  flex: 1;
  padding: 20rpx 20rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(14, 14, 18, 0.94) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.leader-card-kicker {
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
  letter-spacing: 1.5rpx;
}

.leader-card-main {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.leader-card-rank {
  color: #e10600;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.leader-card-body {
  min-width: 0;
}

.leader-card-name {
  color: rgba(255, 255, 255, 0.96);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.leader-card-sub {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.leader-card-points {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.leader-card-points-value {
  color: rgba(255, 255, 255, 0.98);
  font-size: 42rpx;
  line-height: 1;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.leader-card-points-unit {
  color: rgba(255, 255, 255, 0.54);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.hint {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  margin-bottom: 16rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(7, 7, 12, 0.76);
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
}

.error {
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 120, 120, 0.2);
  background: rgba(64, 8, 8, 0.24);
  color: rgba(255, 120, 120, 0.9);
  font-size: 24rpx;
}

.standings-card {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background:
    linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.18);
}

.card-accent {
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  opacity: 0.96;
}

.top-1 {
  border-color: rgba(255, 230, 160, 0.18);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.24);
}

.top-2 {
  border-color: rgba(235, 238, 244, 0.12);
}

.top-3 {
  border-color: rgba(214, 150, 108, 0.14);
}

.rank-col {
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.rank-badge {
  min-width: 60rpx;
  height: 60rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.top-1 .rank-badge {
  background: linear-gradient(180deg, rgba(255, 232, 168, 0.2) 0%, rgba(255, 232, 168, 0.08) 100%);
  color: #fff3cf;
}

.top-2 .rank-badge {
  background: linear-gradient(180deg, rgba(214, 221, 230, 0.16) 0%, rgba(214, 221, 230, 0.06) 100%);
  color: #eef1f6;
}

.top-3 .rank-badge {
  background: linear-gradient(180deg, rgba(214, 150, 108, 0.18) 0%, rgba(214, 150, 108, 0.06) 100%);
  color: #f4d3bd;
}

.card-left {
  width: 96rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar-shell {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.driver {
  color: rgba(255, 255, 255, 0.96);
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: rgba(255, 255, 255, 0.54);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.team {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-row {
  margin-top: 4rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.progress-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
}

.progress-fill {
  height: 100%;
  min-width: 10rpx;
  border-radius: 999rpx;
}

.gap {
  flex: none;
  color: rgba(255, 255, 255, 0.48);
  font-size: 20rpx;
  letter-spacing: 0.5rpx;
}

.card-right {
  width: 98rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
}

.pts {
  color: rgba(255, 255, 255, 0.98);
  font-size: 40rpx;
  line-height: 1;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.pts-unit {
  color: rgba(255, 255, 255, 0.5);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}
