@import "../../styles/data-page.wxss";

.card-left {
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.driver {
  font-weight: 800;
  color: rgba(255, 255, 255, 0.94);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.team {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lap {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.card-right {
  width: 72rpx;
  display: flex;
  justify-content: flex-end;
}

.pos {
  font-weight: 800;
  font-size: 36rpx;
  font-family: Formula1, sans-serif;
}

.tabs {
  position: relative;
  overflow: hidden;
}

.sr-tab-item {
  position: relative;
  z-index: 2;
}

.tabs .dp-tab-active {
  background: transparent;
  box-shadow: none;
}

.tab-indicator {
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.22) 0%, rgba(225, 6, 0, 0.12) 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(225, 6, 0, 0.22),
    0 10rpx 24rpx rgba(225, 6, 0, 0.1);
  z-index: 1;
}

.tab-swiper-shell {
  position: relative;
  overflow: hidden;
  transition: height 240ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tab-swiper {
  width: 100%;
  height: 100%;
}

.tab-page {
  box-sizing: border-box;
  min-height: 100%;
}

.boxplot {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chart-guide {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.18);
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.1) 0%, rgba(255, 255, 255, 0.03) 100%);
}

.chart-guide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.chart-guide-title {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.chart-guide-close {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.76);
  font-size: 28rpx;
  line-height: 1;
}

.chart-guide-text {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 22rpx;
  line-height: 34rpx;
}

.boxplot-summary {
  margin-top: -2rpx;
}

.boxplot-summary-title {
  color: rgba(255, 255, 255, 0.94);
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.boxplot-summary-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  line-height: 32rpx;
}

.boxplot-summary-grid {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.boxplot-summary-card {
  flex: 1;
  min-width: 0;
  padding: 16rpx 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
}

.boxplot-summary-metric {
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
  line-height: 28rpx;
}

.boxplot-summary-driver {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.boxplot-summary-value {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.boxplot-summary-note {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 20rpx;
  line-height: 28rpx;
}

.boxplot-share {
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx;
  opacity: 0.9;
}

.telemetry {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.telemetry-hint {
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  padding: 0 6rpx;
}

.telemetry-summary {
  margin-top: -2rpx;
}

.telemetry-summary-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.telemetry-summary-title {
  color: rgba(255, 255, 255, 0.94);
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.telemetry-summary-compare {
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
}

.telemetry-sector-grid {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.telemetry-sector-card {
  flex: 1;
  min-width: 0;
  padding: 16rpx 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
}

.telemetry-sector-name {
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.telemetry-sector-driver {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.telemetry-sector-value {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.telemetry-sector-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 20rpx;
  line-height: 28rpx;
}

.telemetry-insight {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.12);
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
}

.telemetry-insight-title {
  color: #e10600;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.telemetry-insight-text {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 22rpx;
  line-height: 34rpx;
}

.telemetry-share {
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx;
  opacity: 0.9;
}

.pick-mark {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
