.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tabs {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin: 12rpx 0 16rpx 0;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 700;
}

.tab-active {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.card-left {
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.driver {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.team {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lap {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.card-right {
  width: 72rpx;
  display: flex;
  justify-content: flex-end;
}

.pos {
  font-weight: 800;
  font-size: 34rpx;
}

.boxplot {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.boxplot-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.boxplot-selected {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.boxplot-btn {
  flex: none;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-weight: 700;
}

.boxplot-chart {
  min-height: 520rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
  overflow: hidden;
}

.telemetry {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.telemetry-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.telemetry-selected {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.telemetry-btn {
  flex: none;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-weight: 700;
}

.telemetry-hint {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  padding: 0 6rpx;
}

.telemetry-chart {
  min-height: 520rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
  overflow: hidden;
}

.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 900;
}

.picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 120rpx;
  bottom: 120rpx;
  background: #0a0a0a;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  z-index: 901;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.picker-title {
  font-weight: 900;
}

.picker-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.picker-btn {
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-weight: 700;
}

.picker-btn-primary {
  background: rgba(255, 255, 255, 0.12);
}

.picker-list {
  flex: 1;
  overflow: auto;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pick-mark {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
