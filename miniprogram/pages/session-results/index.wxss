@import "../../styles/data-page.wxss";

.card-left {
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.driver {
  font-weight: 800;
  color: rgba(255, 255, 255, 0.94);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.team {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lap {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.card-right {
  width: 72rpx;
  display: flex;
  justify-content: flex-end;
}

.pos {
  font-weight: 800;
  font-size: 36rpx;
  font-family: Formula1, sans-serif;
}

.boxplot {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.boxplot-share {
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx;
  opacity: 0.9;
}

.telemetry {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.telemetry-hint {
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  padding: 0 6rpx;
}

.telemetry-share {
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx;
  opacity: 0.9;
}

.pick-mark {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
