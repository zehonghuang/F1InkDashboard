.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.tabs {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  margin: 14rpx 0 20rpx 0;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 7, 12, 0.88);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.62);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.tab-active {
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.2) 0%, rgba(225, 6, 0, 0.12) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(225, 6, 0, 0.22);
  color: #ffffff;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.18);
}

.card-left {
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.driver {
  font-weight: 800;
  color: rgba(255, 255, 255, 0.94);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.team {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lap {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.card-right {
  width: 72rpx;
  display: flex;
  justify-content: flex-end;
}

.pos {
  font-weight: 800;
  font-size: 36rpx;
  font-family: Formula1, sans-serif;
}

.boxplot {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.boxplot-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 7, 12, 0.88);
}

.boxplot-selected {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.boxplot-btn {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.24);
  background: rgba(225, 6, 0, 0.14);
  color: #ffffff;
  font-weight: 700;
}

.boxplot-chart {
  min-height: 520rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(10, 10, 14, 0.98) 0%, rgba(5, 5, 8, 1) 100%);
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.boxplot-share {
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx;
  opacity: 0.9;
}

.telemetry {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.telemetry-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 7, 12, 0.88);
}

.telemetry-selected {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.telemetry-btn {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.24);
  background: rgba(225, 6, 0, 0.14);
  color: #ffffff;
  font-weight: 700;
}

.telemetry-hint {
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  padding: 0 6rpx;
}

.telemetry-chart {
  min-height: 520rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(10, 10, 14, 0.98) 0%, rgba(5, 5, 8, 1) 100%);
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.telemetry-share {
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx;
  opacity: 0.9;
}

.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 900;
}

.picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 120rpx;
  bottom: 120rpx;
  background: #0b0b10;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  z-index: 901;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.picker-title {
  font-weight: 900;
}

.picker-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.picker-btn {
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-weight: 700;
}

.picker-btn-primary {
  background: rgba(225, 6, 0, 0.16);
  border-color: rgba(225, 6, 0, 0.24);
}

.picker-list {
  flex: 1;
  overflow: auto;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pick-mark {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
