.tabs-host {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  background: #0f0f16;
  -webkit-user-select: none;
  user-select: none;
  overflow: hidden;
}

.tab-swiper {
  width: 100vw;
  height: 100vh;
  display: block;
}

.host-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding-top: 0;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(7, 7, 12, 0.96);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.36);
  pointer-events: auto;
}

.host-tabbar-inner {
  height: 104rpx;
  padding: 8rpx 16rpx 0;
  box-sizing: border-box;
  pointer-events: auto;
}

.host-tabbar-track {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: row;
}

.host-tab-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.18) 0%, rgba(225, 6, 0, 0.08) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(225, 6, 0, 0.22);
  z-index: 0;
  pointer-events: none;
  will-change: transform, width;
}

.host-tabbar-item {
  flex: 1;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  transition: transform 120ms ease;
}

.host-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  transition: transform 120ms ease, background-color 120ms ease, box-shadow 120ms ease;
}

.host-tabbar-item.is-selected .host-icon-wrap {
  background: rgba(225, 6, 0, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(225, 6, 0, 0.24);
}

.host-tabbar-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  color: rgba(255, 255, 255, 0.56);
  letter-spacing: 1rpx;
  transition: color 120ms ease;
}

.host-tabbar-item.is-selected .host-tabbar-label {
  color: rgba(255, 255, 255, 0.94);
}

.host-tabbar-item--pressed .host-icon-wrap {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.92);
}

.host-tabbar-item--pressed {
  transform: scale(0.98);
}
