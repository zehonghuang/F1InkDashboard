<view class="page">
  <view class="header">
    <view class="title">{{driverName}}</view>
    <view class="subtitle">{{raceName}} · {{sessionName}}</view>
  </view>

  <view class="lap-picker" wx:if="{{showLapPicker}}">
    <picker mode="selector" range="{{lapOptions}}" range-key="label" value="{{lapIndex}}" bindchange="onLapChange">
      <view class="lap-pill">
        <view class="lap-text">{{(lapOptions[lapIndex] && lapOptions[lapIndex].label) || "最快圈"}}</view>
        <view class="lap-arrow">▼</view>
      </view>
    </picker>
  </view>

  <view class="section">
    <view class="section-title">油门 / 刹车 (%)</view>
    <view class="section-desc" wx:if="{{lapInfo}}">{{lapInfo}}</view>
    <ec-canvas canvasId="tb_chart" heightRpx="360" option="{{chartOptionTB}}" />
  </view>

  <view class="section">
    <view class="section-title">Speed (km/h)</view>
    <ec-canvas canvasId="spd_chart" heightRpx="360" option="{{chartOptionSpeed}}" />
  </view>

  <view class="driver-share" bindtap="onCopyTelemetryLink">
    <i-icon type="share" size="18" color="rgba(255,255,255,0.5)" />
  </view>
</view>
