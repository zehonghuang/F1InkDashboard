.section {
  margin-top: 16rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.lap-picker {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-start;
}

.lap-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.lap-text {
  color: #ffffff;
  font-weight: 600;
}

.lap-arrow {
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
}

.section-title {
  font-weight: 700;
  margin-bottom: 8rpx;
}

.section-desc {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.driver-share {
  display: flex;
  justify-content: flex-end;
  padding: 10rpx 16rpx 0;
  opacity: 0.9;
}
