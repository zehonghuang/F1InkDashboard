<t-navbar title="遥测仪表盘" right-text="设置" bind:right-click="goSettings" />

<view class="container">
  <view class="section">
    <t-card bordered="false">
      <t-cell title="车辆" note="{{session.vehicle}}" />
      <t-cell title="赛道" note="{{session.track}}" />
      <t-cell title="会话" note="{{session.name}}" />
    </t-card>
  </view>

  <view class="section">
    <scroll-view class="kpi-scroll" scroll-x="true" show-scrollbar="false">
      <view class="kpi-row">
        <telemetry-kpi-card title="速度" value="{{kpi.speed}}" unit="km/h" />
        <telemetry-kpi-card title="转速" value="{{kpi.rpm}}" unit="rpm" />
        <telemetry-kpi-card title="油门" value="{{kpi.throttle}}" unit="%" />
        <telemetry-kpi-card title="刹车" value="{{kpi.brake}}" unit="%" />
        <telemetry-kpi-card title="档位" value="{{kpi.gear}}" unit="" />
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <t-tabs value="{{activeTab}}" bind:change="onTabChange">
      <t-tab-panel value="power" label="动力">
        <t-card bordered="false" bind:click="goDetail">
          <view class="chart-wrap">
            <ec-canvas id="chart-power" canvas-id="chart-power" echarts="{{echarts}}" ec="{{ec}}" />
          </view>
        </t-card>
      </t-tab-panel>
      <t-tab-panel value="pedal" label="踏板">
        <t-card bordered="false" bind:click="goDetail">
          <view class="chart-wrap">
            <ec-canvas id="chart-pedal" canvas-id="chart-pedal" echarts="{{echarts}}" ec="{{ec}}" />
          </view>
        </t-card>
      </t-tab-panel>
      <t-tab-panel value="gear" label="档位">
        <t-card bordered="false" bind:click="goDetail">
          <view class="chart-wrap">
            <ec-canvas id="chart-gear" canvas-id="chart-gear" echarts="{{echarts}}" ec="{{ec}}" />
          </view>
        </t-card>
      </t-tab-panel>
    </t-tabs>
  </view>

  <view class="section">
    <t-card bordered="false">
      <t-cell-group>
        <t-cell title="进入详情页" note="多图联动与通道开关" arrow bind:click="goDetail" />
      </t-cell-group>
    </t-card>
  </view>
</view>
