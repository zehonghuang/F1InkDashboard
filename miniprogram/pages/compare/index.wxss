.section {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.section-title {
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #ffffff;
}

.section-desc {
  color: rgba(255, 255, 255, 0.72);
  margin-bottom: 16rpx;
}

.tabs {
  margin-top: 10rpx;
  display: flex;
  gap: 14rpx;
}

.tab {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.78);
  background: rgba(0, 0, 0, 0.4);
  font-size: 26rpx;
}

.tab-active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

.slot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.slot-main {
  min-width: 0;
  flex: 1;
}

.slot-name {
  color: #ffffff;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot-meta {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot-actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-start;
}

.lap-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.lap-text {
  color: #ffffff;
  font-weight: 600;
}

.lap-arrow {
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
}

.mini-btn {
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.08);
  font-size: 24rpx;
}

.kv {
  margin-top: 8rpx;
}

.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.kv-row:first-child {
  border-top: none;
}

.kv-k {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.kv-v {
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  text-align: right;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #ffffff;
  background: #000000;
  font-size: 28rpx;
}

.btn-primary {
  background: rgba(255, 255, 255, 0.12);
}
