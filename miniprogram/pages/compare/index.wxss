.section {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.section-title {
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #ffffff;
}

.section-desc {
  color: rgba(255, 255, 255, 0.72);
  margin-bottom: 16rpx;
}

.item {
  color: #ffffff;
  font-weight: 600;
}

.item-desc {
  color: rgba(255, 255, 255, 0.72);
  margin: 6rpx 0 14rpx;
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 10rpx 0 14rpx;
}

.btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #ffffff;
  background: #000000;
  font-size: 28rpx;
}

.btn-primary {
  background: rgba(255, 255, 255, 0.12);
}
