.section {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.92) 0%, rgba(7, 7, 11, 0.96) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.24);
}

.mine {
  padding-top: 48rpx;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.14) 0, rgba(225, 6, 0, 0) 34%),
    linear-gradient(180deg, #15151e 0%, #101018 56%, #09090f 100%);
}

.hero {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  padding: 0 24rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(18, 18, 24, 0.86) 0%, rgba(7, 7, 10, 0.96) 100%);
  box-shadow: 0 24rpx 52rpx rgba(0, 0, 0, 0.28);
}

.hero-bg-fallback {
  background:
    radial-gradient(circle at 15% 0%, rgba(225, 6, 0, 0.34) 0, rgba(225, 6, 0, 0.08) 26%, rgba(225, 6, 0, 0) 58%),
    linear-gradient(180deg, rgba(34, 8, 10, 0.86) 0%, rgba(21, 21, 30, 0.34) 46%, rgba(21, 21, 30, 0) 100%);
}

.hero-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 460rpx;
  width: 100%;
}

.hero-bg-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 460rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.04) 0%, rgba(0, 0, 0, 0.18) 38%, rgba(0, 0, 0, 0.46) 100%);
  pointer-events: none;
}

.hero-head {
  position: relative;
  z-index: 2;
  padding: 16rpx 0 22rpx;
}

.profile-card {
  position: relative;
  z-index: 2;
  padding: 24rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(8, 8, 12, 0.48);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12rpx);
}

.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 34rpx;
  font-family: Formula1, sans-serif;
  color: rgba(255, 255, 255, 0.85);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.profile-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-metrics {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.metric {
  flex: 1;
  min-width: 0;
}

.metric-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.58);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.metric-val {
  margin-top: 10rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  min-height: 48rpx;
}

.metric-text {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 800;
}

.metric-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: rgba(225, 6, 0, 0.12);
  border: 1rpx solid rgba(225, 6, 0, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn {
  font-size: 24rpx;
  line-height: 36rpx;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  font-weight: 700;
}

.btn-primary {
  background: linear-gradient(180deg, #ff3a31 0%, #e10600 100%);
  color: #ffffff;
  border: 1rpx solid rgba(225, 6, 0, 0.5);
  box-shadow: 0 12rpx 28rpx rgba(225, 6, 0, 0.24);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.section-title {
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.more-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx 0;
}

.more-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 12rpx 0;
}

.more-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.9);
}

.more-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.78);
}

.more-item-disabled .more-icon {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.5);
}

.more-item-disabled .more-text {
  color: rgba(255, 255, 255, 0.55);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.row-key {
  color: #ffffff;
  font-weight: 600;
}

.row-val {
  color: rgba(255, 255, 255, 0.64);
}

.stack {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
}

.stack-item {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.12);
  margin-left: -14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stack-item:first-child {
  margin-left: 0;
}

.stack-img {
  width: 100%;
  height: 100%;
}

.stack-placeholder {
  font-size: 18rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.9);
}

.stack-more {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  overflow: hidden;
  margin-left: -14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.88);
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
  margin: 12rpx 0;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.nickname-input {
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
}

.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 900;
}

.picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 120rpx;
  bottom: 120rpx;
  background: #0b0b10;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  z-index: 901;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.picker-title {
  font-weight: 900;
  letter-spacing: 1rpx;
}

.picker-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.picker-btn {
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-weight: 700;
}

.picker-btn-primary {
  background: rgba(225, 6, 0, 0.16);
  border-color: rgba(225, 6, 0, 0.24);
}

.picker-list {
  flex: 1;
  overflow: auto;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(11, 11, 15, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  margin: 0 12rpx;
}

.card-left {
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-mid-team {
  gap: 0;
}

.team-title {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.driver {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.team {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-right {
  width: 72rpx;
  display: flex;
  justify-content: flex-end;
}

.pick-mark {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
