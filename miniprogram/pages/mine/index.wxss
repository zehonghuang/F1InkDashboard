.section {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.92) 0%, rgba(7, 7, 11, 0.96) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.24);
}

.mine {
  padding-top: 48rpx;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.14) 0, rgba(225, 6, 0, 0) 34%),
    linear-gradient(180deg, #15151e 0%, #101018 56%, #09090f 100%);
}

.hero {
  position: relative;
  min-height: 460rpx;
  will-change: transform;
}

.hero-pulling {
  box-shadow: 0 30rpx 64rpx rgba(0, 0, 0, 0.32);
}

.hero-cover-frame {
  position: relative;
  overflow: hidden;
  min-height: 460rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(18, 18, 24, 0.86) 0%, rgba(7, 7, 10, 0.96) 100%);
  box-shadow: 0 24rpx 52rpx rgba(0, 0, 0, 0.28);
}

.hero-bg-fallback {
  background:
    radial-gradient(circle at 15% 0%, rgba(225, 6, 0, 0.34) 0, rgba(225, 6, 0, 0.08) 26%, rgba(225, 6, 0, 0) 58%),
    linear-gradient(180deg, rgba(34, 8, 10, 0.86) 0%, rgba(21, 21, 30, 0.34) 46%, rgba(21, 21, 30, 0) 100%);
}

.hero-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 460rpx;
  width: 100%;
}

.hero-custom-bg {
  position: absolute;
  inset: 0;
  background-position: center center;
  background-repeat: no-repeat;
  background-size: cover;
}

.hero-bg-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 460rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.04) 0%, rgba(0, 0, 0, 0.18) 38%, rgba(0, 0, 0, 0.46) 100%);
  pointer-events: none;
}

.hero-pull-indicator {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: calc(env(safe-area-inset-top) + 20rpx);
  z-index: 3;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.hero-pull-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(8, 8, 12, 0.56);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 1.2;
  backdrop-filter: blur(12rpx);
}

.hero-pull-pill-ready {
  background: rgba(225, 6, 0, 0.24);
  border-color: rgba(225, 6, 0, 0.34);
  color: #ffffff;
}

.profile-card {
  position: absolute;
  z-index: 2;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 24rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(8, 8, 12, 0.48);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12rpx);
}

.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 34rpx;
  font-family: Formula1, sans-serif;
  color: rgba(255, 255, 255, 0.85);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.profile-guide {
  margin-top: 18rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.04) 100%);
}

.profile-guide-standalone {
  margin-top: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
}

.profile-guide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.profile-guide-title {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.profile-guide-badge {
  flex: none;
  min-width: 72rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(225, 6, 0, 0.16);
  border: 1rpx solid rgba(225, 6, 0, 0.28);
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
}

.profile-guide-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
  line-height: 30rpx;
}

.profile-guide-step {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.profile-guide-step-main {
  min-width: 0;
  flex: 1;
}

.profile-guide-step-title {
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 600;
}

.profile-guide-step-desc {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
  line-height: 28rpx;
}

.profile-guide-step-status {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.profile-guide-step-status-done {
  background: rgba(46, 232, 216, 0.14);
  border-color: rgba(46, 232, 216, 0.26);
  color: #b8fff8;
}

.profile-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-sync-hint {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.54);
  font-size: 22rpx;
  line-height: 32rpx;
}

.btn {
  font-size: 24rpx;
  line-height: 36rpx;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  font-weight: 700;
}

.btn-primary {
  background: linear-gradient(180deg, #ff3a31 0%, #e10600 100%);
  color: #ffffff;
  border: 1rpx solid rgba(225, 6, 0, 0.5);
  box-shadow: 0 12rpx 28rpx rgba(225, 6, 0, 0.24);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.nickname-input {
  margin-top: 16rpx;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(8, 8, 12, 0.42);
  color: #ffffff;
  font-size: 24rpx;
}

.section-title {
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.follow-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.follow-card {
  min-width: 0;
  padding: 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(16, 16, 22, 0.94) 0%, rgba(8, 8, 12, 0.98) 100%);
}

.follow-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.follow-card-title {
  min-width: 0;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 700;
}

.follow-card-count {
  flex: none;
  color: rgba(255, 255, 255, 0.48);
  font-size: 20rpx;
}

.follow-card-stack {
  margin-top: 18rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
}

.follow-card-empty {
  color: rgba(255, 255, 255, 0.4);
  font-size: 20rpx;
  line-height: 28rpx;
}

.follow-card-value {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 600;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.stack {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
}

.stack-item {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.12);
  margin-left: -14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stack-item:first-child {
  margin-left: 0;
}

.stack-img {
  width: 100%;
  height: 100%;
}

.stack-placeholder {
  font-size: 18rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.9);
}

.stack-more {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  overflow: hidden;
  margin-left: -14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.88);
}

.more-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx 0;
}

.more-item {
  width: 33.3333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 12rpx 0;
}

.more-item-feature {
  padding: 16rpx 12rpx 8rpx;
  box-sizing: border-box;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-card {
  min-width: 0;
  min-height: 220rpx;
  padding: 20rpx 18rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background:
    radial-gradient(circle at top right, rgba(225, 6, 0, 0.12) 0, rgba(225, 6, 0, 0) 40%),
    linear-gradient(180deg, rgba(14, 16, 22, 0.98) 0%, rgba(8, 8, 12, 0.98) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  display: flex;
  flex-direction: column;
}

.quick-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.quick-card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.quick-card-icon-image {
  overflow: hidden;
}

.quick-card-icon-asset {
  width: 62rpx;
  height: 62rpx;
  display: block;
}

.quick-card-badge {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
  line-height: 1;
}

.quick-card-title {
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.quick-card-desc {
  margin-top: 10rpx;
  min-height: 60rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 21rpx;
  line-height: 30rpx;
}

.quick-card-link {
  margin-top: auto;
  padding-top: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
  font-weight: 700;
}

.more-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.9);
}

.more-icon-image-wrap {
  overflow: hidden;
}

.more-icon-image {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

.more-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.78);
  text-align: center;
}

.more-subtext {
  margin-top: 8rpx;
  max-width: 220rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.more-item-disabled .more-icon {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.5);
}

.more-item-disabled .more-text {
  color: rgba(255, 255, 255, 0.55);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.row-key {
  color: #ffffff;
  font-weight: 600;
}

.row-val {
  color: rgba(255, 255, 255, 0.64);
}

.shop-section {
  overflow: hidden;
}

.shop-inline-head {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.shop-inline-head::before {
  content: "";
  position: absolute;
  left: 0;
  right: 120rpx;
  top: -22rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(225, 6, 0, 0.84) 0%, rgba(255, 255, 255, 0.18) 100%);
}

.shop-inline-head-main {
  min-width: 0;
  flex: 1;
}

.shop-inline-eyebrow {
  color: #ff6b63;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.shop-inline-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.shop-inline-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 22rpx;
  line-height: 32rpx;
}

.shop-inline-pill {
  flex: none;
  margin-top: 2rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  line-height: 1;
}

.shop-inline-shell {
  margin-top: 18rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  background:
    radial-gradient(circle at top right, rgba(225, 6, 0, 0.12) 0, rgba(225, 6, 0, 0) 42%),
    linear-gradient(180deg, rgba(12, 12, 18, 0.96) 0%, rgba(7, 7, 11, 0.98) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04),
    0 14rpx 34rpx rgba(0, 0, 0, 0.18);
}

.shop-inline-embed {
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.02);
}

.shop-inline-embed store-home {
  display: block;
  width: 100%;
}

.shop-inline-empty {
  margin-top: 18rpx;
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.shop-inline-empty-title {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.shop-inline-empty-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  line-height: 32rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 8rpx 0;
  min-height: 76rpx;
}

.action-main {
  flex: 1;
  min-width: 0;
}

.action-label {
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  font-weight: 700;
}

.action-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-side {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: none;
}

.action-meta {
  color: rgba(255, 255, 255, 0.52);
  font-size: 20rpx;
}

.action-arrow {
  color: rgba(255, 255, 255, 0.4);
  font-size: 30rpx;
  line-height: 1;
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
  margin: 12rpx 0;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.wechat-group-fab {
  position: fixed;
  right: 20rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.26);
  backdrop-filter: blur(14rpx);
  z-index: 120;
}

.wechat-group-fab-core {
  position: relative;
  width: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 30% 28%, rgba(92, 232, 144, 0.96) 0%, rgba(92, 232, 144, 0.28) 18%, rgba(92, 232, 144, 0) 34%),
    linear-gradient(180deg, rgba(36, 183, 95, 0.96) 0%, rgba(15, 142, 69, 1) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.22),
    0 10rpx 22rpx rgba(8, 92, 42, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.wechat-group-fab-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
  opacity: 0.94;
}

.wechat-group-fab-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.wechat-group-fab-corner {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border: 3rpx solid #ffffff;
}

.wechat-group-fab-corner-tl {
  left: 0;
  top: 0;
  border-right: none;
  border-bottom: none;
}

.wechat-group-fab-corner-tr {
  right: 0;
  top: 0;
  border-left: none;
  border-bottom: none;
}

.wechat-group-fab-corner-bl {
  left: 0;
  bottom: 0;
  border-right: none;
  border-top: none;
}

.wechat-group-fab-corner-br {
  right: 0;
  bottom: 0;
  border-left: none;
  border-top: none;
}

.wechat-group-fab-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  margin-top: -4rpx;
  border-radius: 3rpx;
  background: #ffffff;
}

.wechat-group-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 920;
  animation: wechat-group-mask-in 180ms ease-out both;
}

.wechat-group-popup {
  position: fixed;
  right: 22rpx;
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  width: 372rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(13, 13, 18, 0.96) 0%, rgba(7, 7, 11, 0.985) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 22rpx 54rpx rgba(0, 0, 0, 0.34);
  z-index: 921;
  transform-origin: calc(100% - 30rpx) calc(100% - 16rpx);
  animation: wechat-group-popup-enter 220ms cubic-bezier(0.2, 0.9, 0.24, 1) both;
}

.wechat-group-popup-tail {
  position: absolute;
  right: 32rpx;
  bottom: -10rpx;
  width: 20rpx;
  height: 20rpx;
  transform: rotate(45deg);
  background: rgba(8, 8, 12, 0.98);
  border-right: 1rpx solid rgba(255, 255, 255, 0.08);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.wechat-group-popup-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.wechat-group-popup-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.wechat-group-popup-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.54);
  font-size: 20rpx;
  line-height: 28rpx;
}

.wechat-group-popup-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.76);
  font-size: 30rpx;
  line-height: 48rpx;
  text-align: center;
  flex: none;
}

.wechat-group-qr-shell {
  position: relative;
  margin-top: 18rpx;
  min-height: 306rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(21, 21, 30, 0.96) 0%, rgba(11, 11, 16, 0.98) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.wechat-group-qr {
  width: 100%;
  height: 306rpx;
  display: block;
}

.wechat-group-qr-hidden {
  opacity: 0;
}

.wechat-group-qr-visible {
  opacity: 1;
}

.wechat-group-qr-state {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.54);
  font-size: 22rpx;
  line-height: 32rpx;
}

.wechat-group-qr-fake {
  min-height: 306rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0 16rpx;
  box-sizing: border-box;
}

.wechat-group-qr-board {
  position: relative;
  width: 276rpx;
  height: 276rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.16);
}

.wechat-group-qr-cell {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 2rpx;
  background: #111111;
}

.wechat-group-qr-fake-note {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
  line-height: 26rpx;
}

.wechat-group-popup-tip {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
}

@keyframes wechat-group-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes wechat-group-popup-enter {
  from {
    opacity: 0;
    transform: translate3d(12rpx, 18rpx, 0) scale(0.82);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 900;
}

.picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 120rpx;
  bottom: 120rpx;
  background: #0b0b10;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  z-index: 901;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.picker-title {
  font-weight: 900;
  letter-spacing: 1rpx;
}

.picker-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.picker-btn {
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-weight: 700;
}

.picker-btn-primary {
  background: rgba(225, 6, 0, 0.16);
  border-color: rgba(225, 6, 0, 0.24);
}

.picker-list {
  flex: 1;
  overflow: auto;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(11, 11, 15, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  margin: 0 12rpx;
}

.card-left {
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-mid-team {
  gap: 0;
}

.team-title {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.driver {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.team {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-right {
  width: 72rpx;
  display: flex;
  justify-content: flex-end;
}

.pick-mark {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
