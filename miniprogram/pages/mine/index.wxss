.section {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.section-title {
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #ffffff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.row-key {
  color: #ffffff;
  font-weight: 600;
}

.row-val {
  color: rgba(255, 255, 255, 0.72);
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 10rpx 0;
}
