.section {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 34rpx;
  font-family: Formula1, sans-serif;
  color: rgba(255, 255, 255, 0.85);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.profile-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.btn {
  font-size: 24rpx;
  line-height: 36rpx;
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
}

.btn-primary {
  background: #0052d9;
  color: #ffffff;
  border: 1rpx solid rgba(0, 82, 217, 0.4);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.section-title {
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #ffffff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.row-key {
  color: #ffffff;
  font-weight: 600;
}

.row-val {
  color: rgba(255, 255, 255, 0.72);
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 10rpx 0;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.nickname-input {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
}

.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 900;
}

.picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 120rpx;
  bottom: 120rpx;
  background: #0a0a0a;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  z-index: 901;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.picker-title {
  font-weight: 900;
}

.picker-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.picker-btn {
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-weight: 700;
}

.picker-btn-primary {
  background: rgba(255, 255, 255, 0.12);
}

.picker-list {
  flex: 1;
  overflow: auto;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
  margin: 0 12rpx;
}

.card-left {
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-mid-team {
  gap: 0;
}

.team-title {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.driver {
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.team {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-right {
  width: 72rpx;
  display: flex;
  justify-content: flex-end;
}

.pick-mark {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}
