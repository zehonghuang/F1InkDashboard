.section {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 34rpx;
  font-family: Formula1, sans-serif;
  color: rgba(255, 255, 255, 0.85);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.profile-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.btn {
  font-size: 24rpx;
  line-height: 36rpx;
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
}

.btn-primary {
  background: #0052d9;
  color: #ffffff;
  border: 1rpx solid rgba(0, 82, 217, 0.4);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.section-title {
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #ffffff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.row-key {
  color: #ffffff;
  font-weight: 600;
}

.row-val {
  color: rgba(255, 255, 255, 0.72);
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 10rpx 0;
}
