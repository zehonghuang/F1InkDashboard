<view class="page has-tabbar mine">
  <view class="hero" style="padding-top: calc({{ statusBarHeight }}px + 12rpx);">
    <view class="hero-bg hero-bg-fallback"></view>
    <view class="hero-bg-mask"></view>

    <view class="hero-head">
    </view>

    <view class="profile-card">
      <view class="profile">
      <button
        wx:if="{{isLoggedIn && canEditProfile}}"
        class="profile-avatar avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        loading="{{syncingProfile}}"
      >
        <image
          wx:if="{{profile && profile.avatarUrl}}"
          class="profile-avatar-img"
          src="{{profile.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar-placeholder">{{avatarText}}</view>
      </button>
      <view wx:else class="profile-avatar" bindtap="onAvatarTap">
        <image
          wx:if="{{profile && profile.avatarUrl}}"
          class="profile-avatar-img"
          src="{{profile.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar-placeholder">{{avatarText}}</view>
      </view>
      <view class="profile-main">
        <view class="profile-name">{{displayName}}</view>
        <view class="profile-sub">
          <text wx:if="{{isLoggedIn}}">已登录</text>
          <text wx:else>游客浏览中（登录可同步设置）</text>
        </view>
        <input
          wx:if="{{isLoggedIn && !hasNick}}"
          class="nickname-input"
          type="nickname"
          placeholder="请输入昵称"
          value="{{nicknameDraft}}"
          bindblur="onNicknameBlur"
        />
      </view>
      <view class="profile-actions">
        <button
          wx:if="{{!isLoggedIn}}"
          class="btn btn-primary"
          bindtap="onLogin"
          loading="{{loadingLogin}}"
        >
          微信登录
        </button>
        <button
          wx:if="{{isLoggedIn}}"
          class="btn btn-ghost"
          bindtap="onBindDevice"
          loading="{{bindingDevice}}"
        >
          绑定设备
        </button>
      </view>
    </view>

      <view class="hero-metrics">
        <view class="metric" bindtap="onTapItem" data-action="followDrivers">
          <view class="metric-label">关注车手</view>
          <view class="metric-val">
            <view wx:if="{{followDriverThumbs.length}}" class="stack">
              <block wx:for="{{followDriverThumbs}}" wx:key="key" wx:for-item="d" wx:for-index="idx">
                <view class="stack-item" style="z-index: {{100-idx}}; border-color: {{d.color || 'rgba(255,255,255,0.18)'}};">
                  <image wx:if="{{d.url}}" class="stack-img" src="{{d.url}}" mode="aspectFill" />
                  <view wx:else class="stack-placeholder">{{d.text}}</view>
                </view>
              </block>
              <view wx:if="{{followDriverMoreCount>0}}" class="stack-more">+{{followDriverMoreCount}}</view>
            </view>
            <view wx:else class="metric-add">
              <i-icon type="add" size="22" color="rgba(255,255,255,0.85)" />
            </view>
          </view>
        </view>

        <view class="metric" bindtap="onTapItem" data-action="followTeams">
          <view class="metric-label">关注车队</view>
          <view class="metric-val">
            <view wx:if="{{followTeamThumbs.length}}" class="stack">
              <block wx:for="{{followTeamThumbs}}" wx:key="key" wx:for-item="t" wx:for-index="idx">
                <view class="stack-item" style="z-index: {{100-idx}}; border-color: {{t.color || 'rgba(255,255,255,0.18)'}};">
                  <image wx:if="{{t.url}}" class="stack-img" src="{{t.url}}" mode="aspectFill" />
                  <view wx:else class="stack-placeholder">{{t.text}}</view>
                </view>
              </block>
              <view wx:if="{{followTeamMoreCount>0}}" class="stack-more">+{{followTeamMoreCount}}</view>
            </view>
            <view wx:else class="metric-add">
              <i-icon type="add" size="22" color="rgba(255,255,255,0.85)" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isLoggedIn}}" class="section">
    <view class="row">
      <view class="row-key">当前设备ID</view>
      <view class="row-val">{{deviceId || "-"}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">更多功能</view>
    <view class="more-grid">
      <view class="more-item" bindtap="onTapItem" data-action="standings">
        <view class="more-icon">
          <i-icon type="integral" size="26" color="rgba(255,255,255,0.9)" />
        </view>
        <view class="more-text">赛季积分</view>
      </view>
      <view class="more-item more-item-disabled" bindtap="onTapItem" data-action="soon_1">
        <view class="more-icon">...</view>
        <view class="more-text">敬请期待</view>
      </view>
      <view class="more-item more-item-disabled" bindtap="onTapItem" data-action="soon_2">
        <view class="more-icon">...</view>
        <view class="more-text">敬请期待</view>
      </view>
      <view class="more-item more-item-disabled" bindtap="onTapItem" data-action="soon_3">
        <view class="more-icon">...</view>
        <view class="more-text">敬请期待</view>
      </view>
      <view class="more-item more-item-disabled" bindtap="onTapItem" data-action="soon_4">
        <view class="more-icon">...</view>
        <view class="more-text">敬请期待</view>
      </view>
      <view class="more-item more-item-disabled" bindtap="onTapItem" data-action="soon_5">
        <view class="more-icon">...</view>
        <view class="more-text">敬请期待</view>
      </view>
      <view class="more-item more-item-disabled" bindtap="onTapItem" data-action="soon_6">
        <view class="more-icon">...</view>
        <view class="more-text">敬请期待</view>
      </view>
      <view class="more-item more-item-disabled" bindtap="onTapItem" data-action="soon_7">
        <view class="more-icon">...</view>
        <view class="more-text">敬请期待</view>
      </view>
    </view>
  </view>

  <view wx:if="{{isLoggedIn}}" class="section">
    <button class="btn btn-ghost" bindtap="onLogout">退出登录</button>
  </view>

  <view wx:if="{{showPicker}}" class="picker-mask" bindtap="onClosePicker"></view>
  <view wx:if="{{showPicker}}" class="picker">
    <view class="picker-header">
      <view class="picker-title">{{pickerTitle}}</view>
      <view class="picker-actions">
        <view class="picker-btn" bindtap="onPickerCancel">取消</view>
        <view class="picker-btn picker-btn-primary" bindtap="onPickerConfirm">确定</view>
      </view>
    </view>
    <view class="picker-list">
      <block wx:if="{{pickerMode==='drivers'}}">
        <block wx:for="{{driverOptions}}" wx:key="driver_number">
          <view class="card" style="{{item.cardStyle}}" bindtap="onTogglePickDriver" data-driver-number="{{item.driver_number}}">
            <view class="card-left">
              <image class="avatar" src="{{item.headshot_url}}" mode="aspectFit" wx:if="{{item.headshot_url}}" />
            </view>
            <view class="card-mid">
              <view class="driver-row">
                <view class="driver-no">#{{item.driver_number}}</view>
                <view class="driver">{{item.full_name || item.driver_name || item.name_acronym || item.driver_number}}</view>
              </view>
              <view class="team">{{item.team_name || '-'}}</view>
            </view>
            <view class="card-right">
              <view class="pick-mark">{{pickedMap[item.driver_number] ? '✓' : ''}}</view>
            </view>
          </view>
        </block>
      </block>

      <block wx:if="{{pickerMode==='teams'}}">
        <block wx:for="{{teamOptions}}" wx:key="team_key">
          <view class="card" style="{{item.cardStyle}}" bindtap="onTogglePickTeam" data-team-key="{{item.team_key}}">
            <view class="card-left">
              <image class="avatar" src="{{item.team_logo_url}}" mode="aspectFit" wx:if="{{item.team_logo_url}}" />
            </view>
            <view class="card-mid card-mid-team">
              <view class="team-title">{{item.team_name}}</view>
            </view>
            <view class="card-right">
              <view class="pick-mark">{{pickedMap[item.team_key] ? '✓' : ''}}</view>
            </view>
          </view>
        </block>
      </block>
    </view>
  </view>
</view>
