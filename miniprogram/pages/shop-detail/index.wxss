.card {
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.row-key {
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
}

.row-val {
  font-weight: 900;
}

.desc {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  line-height: 1.5;
}

.btn {
  margin-top: 20rpx;
  width: 100%;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  border-radius: 12rpx;
  font-weight: 800;
}

.empty {
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  padding: 12rpx 6rpx;
}

