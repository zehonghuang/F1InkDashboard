.page {
  padding: 24rpx 24rpx 160rpx 24rpx;
  background: #050507;
  color: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
}

.status {
  padding: 60rpx 20rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
}

.status-error {
  color: #ff6a57;
}

.gallery-card {
  background: #0a0a0d;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  overflow: hidden;
}

.gallery-main {
  width: 100%;
  height: 720rpx;
  display: block;
  background: #14141a;
}

.gallery-sub-row {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  overflow-x: auto;
}

.gallery-sub {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #14141a;
  flex-shrink: 0;
}

.header-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #0a0a0d;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.price-sale {
  color: #ff6a57;
  font-weight: 900;
  font-size: 48rpx;
  letter-spacing: -0.5rpx;
}

.price-market {
  color: rgba(255, 255, 255, 0.38);
  font-size: 26rpx;
  text-decoration: line-through;
}

.title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.4;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.58);
  line-height: 1.5;
}

.meta-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.meta-chip-warn {
  color: #ff6a57;
}

.section-title {
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 18rpx;
  letter-spacing: 0.4rpx;
}

.sku-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #0a0a0d;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
}

.sku-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.06);
}

.sku-row:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.sku-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  background: #14141a;
  flex-shrink: 0;
}

.sku-info {
  flex: 1;
  min-width: 0;
}

.sku-spec {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.4;
}

.sku-price-row {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.sku-price {
  color: #ff6a57;
  font-weight: 800;
  font-size: 28rpx;
}

.sku-stock {
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
}

.desc-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #0a0a0d;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
}

.desc-image {
  display: block;
  width: 100%;
  margin: 12rpx 0;
  border-radius: 12rpx;
  background: #14141a;
}

.safe-bottom {
  height: 60rpx;
}

.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(5, 5, 7, 0.92);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  justify-content: flex-end;
  z-index: 10;
}

.buy-btn {
  background: #e10600;
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 900;
  font-size: 28rpx;
  width: 280rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  border: 0;
  box-shadow: 0 10rpx 30rpx rgba(225, 6, 0, 0.28);
}

.empty {
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  padding: 60rpx 20rpx;
  text-align: center;
}
