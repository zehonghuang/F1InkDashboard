<t-navbar title="设置与接入" left-arrow bind:left-click="goBack" />

<view class="container">
  <view class="section">
    <t-card bordered="false">
      <t-cell-group>
        <t-cell title="主题" note="{{themeLabel}}" />
        <t-cell title="刷新策略" note="进入页刷新" />
      </t-cell-group>
    </t-card>
  </view>

  <view class="section">
    <t-card bordered="false">
      <view class="title">ECharts 渲染检测</view>
      <view class="chart-wrap">
        <ec-canvas id="test-chart" canvas-id="test-chart" echarts="{{echarts}}" ec="{{ec}}" />
      </view>
    </t-card>
  </view>

  <view class="section">
    <t-card bordered="false">
      <view class="title">接入示例</view>
      <view class="code">{{sampleJson}}</view>
      <view class="btn-row">
        <t-button size="small" theme="primary" bind:tap="copyJson">复制示例 JSON</t-button>
      </view>
    </t-card>
  </view>
</view>
