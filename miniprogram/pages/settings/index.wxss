.title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.chart-wrap {
  height: 320rpx;
}

.code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 22rpx;
  padding: 12rpx;
  background: #0b1220;
  color: #e5e7eb;
  border-radius: 12rpx;
  white-space: pre;
  overflow: auto;
  max-height: 360rpx;
}

.btn-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

