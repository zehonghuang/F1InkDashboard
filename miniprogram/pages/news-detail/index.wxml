<view class="page">
  <view wx:if="{{ loading }}" class="status">{{i18n.common.loading}}</view>
  <view wx:if="{{ !loading && errorText }}" class="status status-error">{{ errorText }}</view>
  <view class="detail-card">
    <view class="detail-title">{{ title }}</view>
    <view class="detail-meta">
      <view class="detail-tag">{{ tagText }}</view>
      <view class="detail-dot">•</view>
      <view class="detail-time">{{ timeText }}</view>
    </view>
    <view wx:if="{{ contentFormatCode === 'PLAIN' }}" class="detail-content">{{ contentText }}</view>
    <view wx:if="{{ contentFormatCode === 'RICH_TEXT_NODES' }}" class="detail-rich">
      <block wx:for="{{ contentBlocks }}" wx:key="id" wx:for-item="block" wx:for-index="blockIndex">
        <rich-text wx:if="{{ block.type === 'rich' }}" class="detail-rich-block" nodes="{{ block.nodes }}" />
        <view wx:elif="{{ block.type === 'gallery' }}" class="detail-gallery-block" catchtap="onTapGallery" data-block-index="{{ blockIndex }}">
          <view class="detail-gallery-shell detail-gallery-shell-single">
            <image
              wx:if="{{ block.inlineImage && block.inlineImage.src }}"
              class="detail-gallery-image"
              src="{{ block.inlineImage.src }}"
              mode="aspectFill"
              lazy-load
            />
          </view>
        </view>
        <view
          wx:elif="{{ block.type === 'product_card' }}"
          class="product-card"
          data-block-id="{{ block.id }}"
          bindtap="onTapShopCard"
        >
          <view class="product-card__body">
            <view class="product-card__cover product-card__cover--skeleton" wx:if="{{ block.loading }}"></view>
            <view wx:elif="{{ block.errorText }}" class="product-card__cover product-card__cover--error">
              <text class="product-card__err">{{ block.errorText }}</text>
            </view>
            <image
              wx:elif="{{ block.headImg }}"
              class="product-card__cover"
              src="{{ block.headImg }}"
              mode="aspectFill"
              lazy-load
            />
            <view wx:else class="product-card__cover product-card__cover--empty">
              <text class="product-card__empty">SHOP</text>
            </view>
            <view class="product-card__info">
              <view class="product-card__meta">
                <view class="badge-store">
                  <view class="badge-store__dot"></view>
                  F1 Store
                </view>
                <view wx:if="{{ block.statusText }}" class="{{ block.statusClass }}">{{ block.statusText }}</view>
              </view>
              <view wx:if="{{ block.loading }}" class="product-card__skeletons">
                <view class="product-card__skeleton product-card__skeleton--1"></view>
                <view class="product-card__skeleton product-card__skeleton--2"></view>
                <view class="product-card__skeleton product-card__skeleton--3"></view>
              </view>
              <block wx:elif="{{ block.detail }}">
                <view class="product-card__title">{{ block.detail.title || ('商品 ' + block.productID) }}</view>
                <view wx:if="{{ block.detail.sub_title }}" class="product-card__subtitle">{{ block.detail.sub_title }}</view>
                <view class="product-card__price-row">
                  <text class="product-card__price">{{ block.priceText }}</text>
                  <text wx:if="{{ block.marketPriceText && block.marketPriceText !== '-' }}" class="product-card__market">{{ block.marketPriceText }}</text>
                </view>
                <view class="product-card__chips">
                  <view class="chip chip-gray">ID {{ block.productID }}</view>
                  <view
                    wx:if="{{ block.detail.total_stock > 0 || block.detail.total_stock === 0 }}"
                    class="{{ block.detail.total_stock > 0 ? 'chip chip-gray' : 'chip chip-red' }}"
                  >库存 {{ block.detail.total_stock }}</view>
                  <view wx:if="{{ block.skuCount }}" class="chip chip-gray">{{ block.skuCount }} SKU</view>
                </view>
              </block>
              <block wx:else>
                <view class="product-card__title">商品 {{ block.productID }}</view>
              </block>
            </view>
          </view>
          <view class="product-card__cta">
            <text class="product-card__cta-label">前往详情</text>
            <svg class="product-card__cta-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          </view>
        </view>
      </block>
    </view>
  </view>
  <image-deck-viewer
    visible="{{ viewerVisible }}"
    images="{{ articleImages }}"
    initialIndex="{{ viewerInitialIndex }}"
    bindclose="onViewerClose"
  />
</view>
