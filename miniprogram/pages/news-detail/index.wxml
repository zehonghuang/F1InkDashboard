<view class="page">
  <view wx:if="{{ loading }}" class="status">{{i18n.common.loading}}</view>
  <view wx:if="{{ !loading && errorText }}" class="status status-error">{{ errorText }}</view>
  <view class="detail-card">
    <view class="detail-title">{{ title }}</view>
    <view class="detail-meta">
      <view class="detail-tag">{{ tagText }}</view>
      <view class="detail-dot">•</view>
      <view class="detail-time">{{ timeText }}</view>
    </view>
    <view wx:if="{{ contentFormatCode === 'PLAIN' }}" class="detail-content">{{ contentText }}</view>
    <view wx:if="{{ contentFormatCode === 'RICH_TEXT_NODES' }}" class="detail-rich">
      <block wx:for="{{ contentBlocks }}" wx:key="id" wx:for-item="block" wx:for-index="blockIndex">
        <rich-text wx:if="{{ block.type === 'rich' }}" class="detail-rich-block" nodes="{{ block.nodes }}" />
        <view wx:elif="{{ block.type === 'gallery' }}" class="detail-gallery-block" catchtap="onTapGallery" data-block-index="{{ blockIndex }}">
          <view class="detail-gallery-shell detail-gallery-shell-single">
            <image
              wx:if="{{ block.inlineImage && block.inlineImage.src }}"
              class="detail-gallery-image"
              src="{{ block.inlineImage.src }}"
              mode="aspectFill"
              lazy-load
            />
          </view>
        </view>
      </block>
    </view>
  </view>
  <view
    wx:if="{{ viewerShow }}"
    class="detail-viewer-mask {{ viewerActive ? 'detail-viewer-mask-active' : '' }}"
    bindtap="onCloseViewer"
    catchtouchmove="noop"
  >
    <view class="detail-viewer {{ viewerActive ? 'detail-viewer-active' : '' }}" catchtap="noop">
      <view class="detail-viewer-stage">
        <block wx:for="{{ viewerStackImages }}" wx:key="src" wx:for-item="stackImage">
          <view class="detail-viewer-stack-card {{ stackImage.layerClass }}">
            <image class="detail-viewer-stack-image" src="{{ stackImage.src }}" mode="aspectFill" />
          </view>
        </block>
        <swiper
          class="detail-viewer-swiper"
          current="{{ viewerIndex }}"
          bindchange="onViewerChange"
          circular="{{ viewerImages.length > 1 }}"
          indicator-dots="{{ viewerImages.length > 1 }}"
          indicator-color="rgba(255,255,255,0.28)"
          indicator-active-color="#ffffff"
        >
          <block wx:for="{{ viewerImages }}" wx:key="src" wx:for-item="viewerImage">
            <swiper-item>
              <view class="detail-viewer-slide">
                <view class="detail-viewer-card">
                  <image class="detail-viewer-image" src="{{ viewerImage.src }}" mode="aspectFit" />
                </view>
              </view>
            </swiper-item>
          </block>
        </swiper>
      </view>
      <view class="detail-viewer-topbar">
        <view class="detail-viewer-count">{{ viewerCountText }}</view>
        <view class="detail-viewer-close" bindtap="onCloseViewer">×</view>
      </view>
    </view>
  </view>
</view>
