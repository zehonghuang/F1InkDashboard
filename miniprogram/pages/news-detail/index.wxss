.page {
  min-height: 100vh;
  padding: 24rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.14) 0, rgba(225, 6, 0, 0) 34%),
    linear-gradient(180deg, #15151e 0%, #101018 56%, #09090f 100%);
}

.detail-card {
  padding: 28rpx 24rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 24rpx 54rpx rgba(0, 0, 0, 0.24);
}

.detail-title {
  font-weight: 700;
  font-size: 42rpx;
  line-height: 58rpx;
  color: rgba(255, 255, 255, 0.96);
}

.detail-meta {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.detail-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.22);
  background: rgba(225, 6, 0, 0.14);
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.detail-dot {
  color: rgba(255, 255, 255, 0.5);
}

.detail-time {
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
}

.detail-content {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 48rpx;
}

.detail-rich {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 48rpx;
}

.detail-rich-block {
  margin-top: 18rpx;
}

.detail-rich-block:first-child {
  margin-top: 0;
}

.detail-gallery-block {
  margin-top: 24rpx;
}

.detail-gallery-shell {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.detail-gallery-shell-single {
  height: 440rpx;
}

.detail-gallery-image {
  width: 100%;
  height: 100%;
}

.status {
  margin: 0 0 18rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(7, 7, 12, 0.82);
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.status-error {
  color: rgba(255, 120, 120, 0.9);
  border-color: rgba(255, 120, 120, 0.25);
}
