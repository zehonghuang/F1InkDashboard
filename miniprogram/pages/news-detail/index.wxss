.page {
  min-height: 100vh;
  padding: 20rpx 20rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-card {
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.detail-title {
  font-weight: 700;
  font-size: 36rpx;
  line-height: 50rpx;
}

.detail-meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.detail-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.detail-dot {
  color: rgba(255, 255, 255, 0.5);
}

.detail-time {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.detail-content {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 44rpx;
}

.detail-rich {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 44rpx;
}

.detail-rich-block {
  margin-top: 16rpx;
}

.detail-rich-block:first-child {
  margin-top: 0;
}

.detail-gallery-block {
  margin-top: 20rpx;
}

.detail-gallery-shell {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
}

.detail-gallery-shell-single {
  height: 440rpx;
}

.detail-gallery-image {
  width: 100%;
  height: 100%;
}

.status {
  margin: 0 0 16rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.65);
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.status-error {
  color: rgba(255, 120, 120, 0.9);
  border-color: rgba(255, 120, 120, 0.25);
}
