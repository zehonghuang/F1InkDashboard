.detail-card {
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.detail-title {
  font-weight: 700;
  font-size: 36rpx;
  line-height: 50rpx;
}

.detail-meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.detail-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.detail-dot {
  color: rgba(255, 255, 255, 0.5);
}

.detail-time {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.detail-content {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 44rpx;
}
