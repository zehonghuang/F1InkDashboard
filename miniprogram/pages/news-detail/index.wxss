.page {
  min-height: 100vh;
  padding: 24rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.14) 0, rgba(225, 6, 0, 0) 34%),
    linear-gradient(180deg, #15151e 0%, #101018 56%, #09090f 100%);
}

.detail-card {
  padding: 28rpx 24rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 24rpx 54rpx rgba(0, 0, 0, 0.24);
}

.detail-title {
  font-weight: 700;
  font-size: 42rpx;
  line-height: 58rpx;
  color: rgba(255, 255, 255, 0.96);
}

.detail-meta {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.detail-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.22);
  background: rgba(225, 6, 0, 0.14);
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.detail-dot {
  color: rgba(255, 255, 255, 0.5);
}

.detail-time {
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
}

.detail-content {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 48rpx;
}

.detail-rich {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 48rpx;
}

.detail-rich-block {
  margin-top: 18rpx;
}

.detail-rich-block:first-child {
  margin-top: 0;
}

.detail-gallery-block {
  margin-top: 24rpx;
}

.detail-gallery-shell {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.detail-gallery-shell-single {
  height: 440rpx;
}

.detail-gallery-image {
  width: 100%;
  height: 100%;
}

.recommend-card {
  margin-top: 20rpx;
  padding: 26rpx 24rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  background:
    linear-gradient(180deg, rgba(225, 6, 0, 0.08) 0%, rgba(225, 6, 0, 0) 42%),
    linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 24rpx 54rpx rgba(0, 0, 0, 0.24);
}

.recommend-card-fallback {
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
}

.recommend-eyebrow {
  color: #e10600;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.recommend-title {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.96);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.recommend-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 40rpx;
}

.recommend-tip {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  line-height: 34rpx;
}

.recommend-product-shell {
  margin-top: 18rpx;
  padding: 2rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
}

.recommend-product-shell store-product {
  display: block;
  width: 100%;
}

.recommend-error {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 120, 120, 0.22);
  background: rgba(92, 18, 18, 0.26);
  color: rgba(255, 160, 160, 0.94);
  font-size: 22rpx;
  line-height: 34rpx;
}

.status {
  margin: 0 0 18rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(7, 7, 12, 0.82);
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.status-error {
  color: rgba(255, 120, 120, 0.9);
  border-color: rgba(255, 120, 120, 0.25);
}

.product-card {
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background:
    radial-gradient(1200rpx circle at 0% 0%, rgba(225, 6, 0, 0.16), transparent 50%),
    linear-gradient(180deg, #0a0a0d 0%, #070709 100%);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.28);
}
.product-card__body {
  padding: 20rpx;
  display: flex;
  gap: 22rpx;
}
.product-card__cover {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #14141a;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.product-card__cover--skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.04), rgba(255,255,255,0.10), rgba(255,255,255,0.04));
  background-size: 200% 100%;
  animation: product-skeleton-shimmer 1.4s linear infinite;
}
@keyframes product-skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.product-card__cover--empty {
  border: 1rpx dashed rgba(255, 255, 255, 0.14);
}
.product-card__cover--error {
  border: 1rpx solid rgba(255, 120, 120, 0.28);
  background: rgba(92, 18, 18, 0.26);
  padding: 18rpx;
}
.product-card__err {
  color: rgba(255, 160, 160, 0.92);
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}
.product-card__empty {
  font-weight: 800;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.18);
  font-size: 28rpx;
}
.product-card__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.product-card__meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.badge-store {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(225, 6, 0, 0.14);
  border: 1rpx solid rgba(225, 6, 0, 0.22);
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.badge-store__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e10600;
  box-shadow: 0 0 10rpx rgba(225, 6, 0, 0.6);
}
.chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}
.chip-gray {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.chip-green {
  background: rgba(61, 211, 121, 0.12);
  color: rgba(128, 247, 180, 0.96);
  border: 1rpx solid rgba(61, 211, 121, 0.24);
}
.chip-amber {
  background: rgba(250, 173, 20, 0.10);
  color: rgba(255, 210, 120, 0.96);
  border: 1rpx solid rgba(250, 173, 20, 0.22);
}
.chip-red {
  background: rgba(225, 6, 0, 0.12);
  color: rgba(255, 154, 154, 0.96);
  border: 1rpx solid rgba(225, 6, 0, 0.24);
}
.product-card__skeletons {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
}
.product-card__skeleton {
  height: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(255,255,255,0.04), rgba(255,255,255,0.10), rgba(255,255,255,0.04));
  background-size: 200% 100%;
  animation: product-skeleton-shimmer 1.4s linear infinite;
}
.product-card__skeleton--1 { width: 78%; }
.product-card__skeleton--2 { width: 92%; height: 32rpx; }
.product-card__skeleton--3 { width: 54%; }
.product-card__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  color: rgba(255, 255, 255, 0.96);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.product-card__subtitle {
  font-size: 22rpx;
  line-height: 32rpx;
  color: rgba(255, 255, 255, 0.58);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.product-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 2rpx;
}
.product-card__price {
  color: #ff6a57;
  font-weight: 800;
  font-size: 34rpx;
  letter-spacing: 0.6rpx;
}
.product-card__market {
  color: rgba(255, 255, 255, 0.42);
  text-decoration: line-through;
  font-size: 22rpx;
}
.product-card__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 2rpx;
}
.product-card__cta {
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, rgba(225, 6, 0, 0.98), rgba(225, 6, 0, 0.78));
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.product-card__cta-label {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.product-card__cta-chevron {
  width: 24rpx;
  height: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}
