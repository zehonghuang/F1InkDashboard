.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.14) 0, rgba(225, 6, 0, 0) 32%),
    linear-gradient(180deg, #15151e 0%, #101018 56%, #09090f 100%);
}

.week-overview {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.overview-card {
  width: calc((100% - 16rpx) / 2);
  min-height: 164rpx;
  box-sizing: border-box;
  padding: 20rpx 20rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(14, 14, 18, 0.94) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.overview-card-wide {
  width: 100%;
  min-height: 184rpx;
  background:
    linear-gradient(180deg, rgba(225, 6, 0, 0.14) 0%, rgba(20, 10, 12, 0.3) 34%, rgba(7, 7, 10, 0.98) 100%);
}

.overview-kicker {
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
  letter-spacing: 1.5rpx;
}

.overview-main {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 900;
}

.overview-value {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.overview-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.section {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.94) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.section-title {
  color: rgba(255, 255, 255, 0.96);
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.section-desc {
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  margin-bottom: 18rpx;
}

.session-timeline {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.session-item {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.session-rail {
  width: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
}

.session-order {
  color: rgba(255, 255, 255, 0.46);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.session-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 10rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.04);
}

.session-dot.is-live {
  background: #e10600;
  box-shadow: 0 0 0 8rpx rgba(225, 6, 0, 0.12);
}

.session-dot.is-upcoming {
  background: rgba(255, 255, 255, 0.88);
}

.session-dot.is-done {
  background: rgba(255, 255, 255, 0.4);
}

.session-line {
  width: 2rpx;
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
}

.session-card {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(11, 11, 15, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.18);
}

.session-card.is-live {
  border-color: rgba(225, 6, 0, 0.2);
  background:
    linear-gradient(180deg, rgba(225, 6, 0, 0.12) 0%, rgba(16, 10, 12, 0.4) 30%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(225, 6, 0, 0.08);
}

.session-card.is-upcoming {
  border-color: rgba(255, 255, 255, 0.1);
}

.session-card.is-done {
  background: linear-gradient(180deg, rgba(10, 10, 14, 0.88) 0%, rgba(7, 7, 10, 0.94) 100%);
}

.session-card-disabled {
  opacity: 0.42;
}

.session-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.session-card-title-wrap {
  flex: 1;
  min-width: 0;
}

.session-name {
  color: rgba(255, 255, 255, 0.96);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.session-sub {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
}

.session-badge {
  flex: none;
  min-width: 88rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.8);
}

.session-badge.is-live {
  border-color: rgba(225, 6, 0, 0.22);
  background: rgba(225, 6, 0, 0.16);
  color: rgba(255, 255, 255, 0.96);
}

.session-badge.is-upcoming {
  background: rgba(255, 255, 255, 0.08);
}

.session-badge.is-done {
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.62);
}

.session-card-bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.session-time {
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

.session-status {
  color: rgba(255, 255, 255, 0.56);
  font-size: 22rpx;
}
