.section {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.section-title {
  font-weight: 700;
  margin-bottom: 10rpx;
}

.list {
  display: flex;
  flex-direction: column;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.row:first-child {
  border-top: none;
}

.row-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.row-name {
  font-weight: 700;
}

.row-sub {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.row-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.row-time {
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
}

.row-status {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.row-disabled {
  opacity: 0.45;
}

