<view class="page">
  <view class="header">
    <view class="title">{{raceName}}</view>
    <view class="subtitle">{{subtitleText}}</view>
  </view>

  <view class="section">
    <view class="section-title">{{i18n.raceSessions.sectionSessions}}</view>
    <view class="list">
      <block wx:for="{{sessions}}" wx:key="key">
        <view class="row {{item.disabled ? 'row-disabled' : ''}}" bindtap="onSessionTap" data-key="{{item.key}}" data-disabled="{{item.disabled}}" data-session-key="{{item.openf1_session_key}}" data-session-name="{{item.namePrimary}}" data-race-name="{{raceName}}">
          <view class="row-left">
            <view class="row-name">{{item.namePrimary}}</view>
            <view class="row-sub">{{item.nameSecondary}}</view>
          </view>
          <view class="row-right">
            <view class="row-time">{{item.start_local}}</view>
            <view class="row-status">{{item.statusText}}</view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
