<view class="page-root">
  <view wx:if="{{ showWelcome && welcome }}" class="welcome" catchtap="onCloseWelcome" catchtouchmove="noop">
    <image class="welcome-image" src="{{ welcome.coverUrl }}" mode="aspectFill" />
    <view class="welcome-mask" />
    <view class="welcome-tip">点击进入</view>
  </view>

  <scroll-view
    id="page-scroll"
    class="page-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{ refreshing }}"
    bindrefresherrefresh="onRefresherRefresh"
    bindscroll="onPageScroll"
    bindscrolltolower="onScrollToLower"
    scrolltolower-threshold="120"
  >
    <view class="page has-tabbar">
      <view class="header" style="padding-top: calc({{ statusBarHeight }}px + 12rpx);">
        <view class="title">F1 资讯</view>
        <view class="subtitle">News • Updates • Insights</view>
      </view>

      <view wx:if="{{ loading }}" class="status">加载中...</view>
      <view wx:if="{{ !loading && errorText }}" class="status status-error">{{ errorText }}</view>
      <view wx:if="{{ !loading && !errorText && !banners.length && !list.length }}" class="status">暂无资讯</view>

      <swiper
        wx:if="{{ banners.length }}"
        class="hero-swiper"
        circular
        autoplay
        indicator-dots
        indicator-color="rgba(255,255,255,0.45)"
        indicator-active-color="#ffffff"
      >
        <block wx:for="{{ banners }}" wx:key="id">
          <swiper-item>
            <view
              class="hero-banner"
              bindtap="onTapCard"
              bindlongpress="onLongPressCard"
              bindtouchend="onReleasePressCard"
              bindtouchcancel="onReleasePressCard"
              data-id="{{ item.id }}"
              hover-class="hero-banner-pressed"
              hover-stay-time="120"
            >
              <image class="hero-image" src="{{ item.coverUrl }}" mode="aspectFill" />
              <view class="hero-mask" />
              <view class="hero-content">
                <view class="hero-title">{{ item.title }}</view>
                <view class="hero-meta">
                  <view class="hero-tag">{{ item.tagText }}</view>
                  <view class="hero-dot">•</view>
                  <view class="hero-time">{{ item.timeText }}</view>
                </view>
              </view>
            </view>
          </swiper-item>
        </block>
      </swiper>

      <view id="news-list" class="news-list" style="{{ listTransformStyle }}">
        <block wx:for="{{ list }}" wx:key="id">
          <view
            id="news-card-{{ item.id }}"
            class="news-card {{ pressJiggleId === item.id ? 'news-card-jiggle' : '' }} {{ item.coverUrl ? 'news-card-with-cover' : '' }} {{ item._prefPromoted ? 'news-card-promoted' : '' }} {{ item._prefHit ? 'news-card-hit' : '' }}"
            style="{{ item._prefMoveHidden ? 'opacity:0;' : '' }}"
            bindtap="onTapCard"
            bindlongpress="onLongPressCard"
            bindtouchend="onReleasePressCard"
            bindtouchcancel="onReleasePressCard"
            data-id="{{ item.id }}"
            hover-class="news-card-pressed"
            hover-stay-time="120"
          >
            <view wx:if="{{ item._prefHit }}" class="news-hit-bar" style="background: {{ item._prefHitColor || '#2EE8D8' }};" />
            <view wx:if="{{ item.coverUrl }}" class="news-cover-wrap">
              <image class="news-cover" src="{{ item.coverUrl }}" mode="aspectFill" lazy-load />
            </view>
            <view class="news-body">
              <view class="news-title">{{ item.title }}</view>
              <view wx:if="{{ !item.coverUrl }}" class="news-summary">{{ item.summary }}</view>
              <view class="news-meta">
                <view class="news-tag">{{ item.tagText }}</view>
                <view class="news-dot">•</view>
                <view class="news-time">{{ item.timeText }}</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{ prefMoveOverlay && prefMoveOverlay.show && prefMoveOverlay.item }}" id="pref-move-overlay" class="pref-move-overlay" style="{{ prefMoveOverlay.style }}">
    <view class="news-card {{ prefMoveOverlay.item.coverUrl ? 'news-card-with-cover' : '' }} news-card-promoted news-card-hit">
      <view class="news-hit-bar" style="background: {{ prefMoveOverlay.item._prefHitColor || '#2EE8D8' }};" />
      <view wx:if="{{ prefMoveOverlay.item.coverUrl }}" class="news-cover-wrap">
        <image class="news-cover" src="{{ prefMoveOverlay.item.coverUrl }}" mode="aspectFill" lazy-load />
      </view>
      <view class="news-body">
        <view class="news-title">{{ prefMoveOverlay.item.title }}</view>
        <view wx:if="{{ !prefMoveOverlay.item.coverUrl }}" class="news-summary">{{ prefMoveOverlay.item.summary }}</view>
        <view class="news-meta">
          <view class="news-tag">{{ prefMoveOverlay.item.tagText }}</view>
          <view class="news-dot">•</view>
          <view class="news-time">{{ prefMoveOverlay.item.timeText }}</view>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{ pressPreview && pressPreview.show && pressPreview.item }}"
    class="press-preview-overlay {{ pressPreview.active ? 'press-preview-overlay-active' : '' }}"
    bindtap="onClosePressPreview"
    catchtouchmove="noop"
  >
    <view class="press-preview {{ pressPreview.active ? 'press-preview-active' : '' }}" catchtap="noop">
      <view class="press-preview-close" bindtap="onClosePressPreview">×</view>
      <view class="press-preview-card" bindtap="onTapPressPreview" hover-class="press-preview-pressed" hover-stay-time="120">
        <view wx:if="{{ pressPreview.item.coverUrl }}" class="press-preview-cover-wrap">
          <image class="press-preview-cover" src="{{ pressPreview.item.coverUrl }}" mode="aspectFill" lazy-load />
        </view>
        <view class="press-preview-body">
          <view class="press-preview-title">{{ pressPreview.item.title }}</view>
          <view wx:if="{{ pressPreview.item.summary }}" class="press-preview-summary">{{ pressPreview.item.summary }}</view>
          <view class="press-preview-meta">
            <view class="press-preview-tag">{{ pressPreview.item.tagText }}</view>
            <view class="press-preview-dot">•</view>
            <view class="press-preview-time">{{ pressPreview.item.timeText }}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
