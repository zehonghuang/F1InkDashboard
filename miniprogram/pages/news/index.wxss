.page-root {
  height: 100vh;
}

.page-scroll {
  height: 100%;
  width: 100%;
}

.news-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.raceweek-countdown {
  margin-top: 16rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx 16rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.92) 100%);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.raceweek-countdown-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.raceweek-countdown-mid {
  width: 84rpx;
  flex: 0 0 84rpx;
  overflow: hidden;
}

.raceweek-countdown-session {
  color: #e10600;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 38rpx;
  white-space: nowrap;
}

.raceweek-countdown-session-compact {
  font-size: 28rpx;
  line-height: 32rpx;
  letter-spacing: 0;
}

.raceweek-countdown-suffix {
  color: #e10600;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.raceweek-countdown-clock {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 26rpx;
}

.raceweek-countdown-seg {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8rpx;
}

.raceweek-countdown-num {
  font-size: 72rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.96);
  line-height: 72rpx;
  font-family: Formula1, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

.raceweek-countdown-unit {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.66);
  line-height: 30rpx;
  letter-spacing: 1rpx;
}

.quali-panel {
  margin-top: 6rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.06);
}

.quali-panel-header {
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quali-panel-title {
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
}

.quali-panel-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.quali-panel-body {
  height: 0;
  opacity: 0;
  overflow: hidden;
  transition: height 220ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease-out;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.quali-panel-body-open {
  height: 460rpx;
  opacity: 1;
}

.welcome {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #000000;
}

.welcome-image {
  width: 100%;
  height: 100%;
}

.welcome-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.72) 100%);
}

.welcome-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 2rpx;
}

.press-preview-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9997;
  background: rgba(255, 255, 255, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  opacity: 0;
  transition: opacity 160ms ease-out;
}

.press-preview-overlay-active {
  opacity: 1;
}

.press-preview {
  width: 100%;
  max-width: 680rpx;
  position: relative;
  transform: translate3d(0, 18rpx, 0) scale(0.98);
  opacity: 0;
  transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease-out;
  will-change: transform, opacity;
}

.press-preview-active {
  transform: translate3d(0, 0, 0) scale(1);
  opacity: 1;
}

.press-preview-close {
  position: absolute;
  right: 0;
  top: -64rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 34rpx;
}

.press-preview-card {
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  background: #000000;
}

.press-preview-pressed {
  opacity: 0.92;
}

.press-preview-cover-wrap {
  width: 100%;
  height: 320rpx;
  background: #0a0a0a;
}

.press-preview-cover {
  width: 100%;
  height: 100%;
}

.press-preview-body {
  padding: 20rpx;
}

.press-preview-title {
  font-weight: 800;
  font-size: 34rpx;
  line-height: 46rpx;
}

.press-preview-summary {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.press-preview-meta {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.press-preview-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.press-preview-dot {
  color: rgba(255, 255, 255, 0.5);
}

.press-preview-time {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

@keyframes newsCardJiggle {
  0% {
    transform: rotate(-0.6deg) scale(0.995);
  }
  50% {
    transform: rotate(0.6deg) scale(0.995);
  }
  100% {
    transform: rotate(-0.6deg) scale(0.995);
  }
}

.news-card-jiggle {
  transform-origin: 50% 50%;
  animation: newsCardJiggle 260ms ease-in-out infinite;
}

.hero-swiper {
  height: 360rpx;
  margin-top: 6rpx;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 2;
}

.hero-banner {
  position: relative;
  height: 360rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  transform: translateY(-6rpx);
  box-shadow: none;
}

.hero-banner-pressed {
  border-radius: 12rpx;
  overflow: hidden;
  opacity: 0.92;
}

.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.16) 0%, rgba(0, 0, 0, 0.8) 65%, rgba(0, 0, 0, 0.92) 100%);
}

.hero-content {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
}

.hero-title {
  font-weight: 800;
  font-size: 36rpx;
  line-height: 50rpx;
}

.hero-meta {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.hero-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.load-more {
  padding: 22rpx 0 calc(36rpx + env(safe-area-inset-bottom));
  text-align: center;
  color: rgba(255, 255, 255, 0.55);
  font-size: 30rpx;
  letter-spacing: 10rpx;
}

.load-more-dot {
  display: inline-block;
  width: 12rpx;
  animation: loadMoreDots 900ms infinite ease-in-out;
  opacity: 0.25;
}

.dot2 {
  animation-delay: 150ms;
}

.dot3 {
  animation-delay: 300ms;
}

.load-more-end {
  padding: 26rpx 0 calc(44rpx + env(safe-area-inset-bottom));
  font-size: 24rpx;
  letter-spacing: 0;
}

@keyframes loadMoreDots {
  0%,
  80%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

.hero-dot {
  color: rgba(255, 255, 255, 0.6);
}

.hero-time {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.hero-card {
  margin-bottom: 16rpx;
}

.news-card {
  position: relative;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
  overflow: hidden;
}

.news-card-with-cover {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.news-cover-wrap {
  width: 176rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: #0a0a0a;
}

.news-cover {
  width: 100%;
  height: 100%;
}

.news-body {
  flex: 1;
  min-width: 0;
}

.news-card-with-cover .news-title {
  font-size: 30rpx;
  line-height: 42rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-card-with-cover .news-summary {
  margin-top: 8rpx;
  line-height: 36rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-card-with-cover .news-meta {
  margin-top: 10rpx;
}

.news-card-promoted {
  animation: prefPromoteIn 520ms cubic-bezier(0.22, 1, 0.36, 1);
  border-color: rgba(255, 255, 255, 0.22);
}

.news-hit-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  opacity: 0.95;
  border-top-left-radius: 12rpx;
  border-bottom-left-radius: 12rpx;
}

.pref-move-overlay {
  position: fixed;
  z-index: 9998;
  pointer-events: none;
  will-change: transform;
}

.news-card-pressed {
  border-radius: 12rpx;
  overflow: hidden;
  opacity: 0.92;
}

@keyframes prefPromoteIn {
  0% {
    transform: translateY(18rpx);
    opacity: 0.2;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.news-title {
  font-weight: 700;
  font-size: 32rpx;
  line-height: 44rpx;
}

.news-summary {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 42rpx;
}

.news-meta {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.news-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.news-dot {
  color: rgba(255, 255, 255, 0.5);
}

.news-time {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.status {
  margin: 8rpx 0 12rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.65);
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.status-error {
  color: rgba(255, 120, 120, 0.9);
  border-color: rgba(255, 120, 120, 0.25);
}
