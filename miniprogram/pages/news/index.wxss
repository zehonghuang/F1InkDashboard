.news-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hero-swiper {
  height: 280rpx;
  margin-bottom: 16rpx;
}

.hero-banner {
  position: relative;
  height: 280rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.82) 100%);
}

.hero-content {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
}

.hero-title {
  font-weight: 800;
  font-size: 36rpx;
  line-height: 50rpx;
}

.hero-meta {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.hero-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.hero-dot {
  color: rgba(255, 255, 255, 0.6);
}

.hero-time {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.hero-card {
  margin-bottom: 16rpx;
}

.news-card {
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.news-title {
  font-weight: 700;
  font-size: 32rpx;
  line-height: 44rpx;
}

.news-summary {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 42rpx;
}

.news-meta {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.news-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.news-dot {
  color: rgba(255, 255, 255, 0.5);
}

.news-time {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}
