.page-root {
  height: 100vh;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.16) 0, rgba(225, 6, 0, 0) 34%),
    linear-gradient(180deg, #15151e 0%, #111118 54%, #0a0a10 100%);
  display: flex;
  flex-direction: column;
}

.page-scroll {
  height: calc(100vh - 200rpx);
  width: 100%;
  min-height: 0;
}

.page {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease-out;
  will-change: transform, opacity;
  transform: translateZ(0);
}

.page-scroll-previewing {
  pointer-events: none;
}

.page-previewing {
  transform: scale(0.986);
  transform-origin: 50% 20%;
  opacity: 0.36;
}

.news-list {
  display: flex;
  flex-direction: column;
}

.news-list .news-card + .news-card {
  margin-top: 18rpx;
}

.news-list .raceweek-countdown + .news-card,
.news-list .quali-panel + .news-card,
.news-list .hero-swiper + .news-card,
.news-list .status + .news-card {
  margin-top: 18rpx;
}

.news-list .load-more {
  margin-top: 18rpx;
}

.raceweek-countdown {
  margin-top: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(14, 14, 18, 0.9) 0%, rgba(6, 6, 10, 0.96) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.28);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.raceweek-countdown-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-right: 20rpx;
}

.raceweek-countdown-left .raceweek-countdown-session + .raceweek-countdown-suffix {
  margin-top: 6rpx;
}

.raceweek-countdown-left-flag-only {
  min-width: 112rpx;
  margin-right: 20rpx;
  align-items: center;
  justify-content: center;
}

.raceweek-countdown-mid {
  width: 84rpx;
  margin-right: 20rpx;
  flex: 0 0 84rpx;
  overflow: hidden;
}

.raceweek-countdown-session {
  color: #e10600;
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.raceweek-countdown-session-compact {
  font-size: 28rpx;
  line-height: 32rpx;
  letter-spacing: 0;
}

.raceweek-countdown-suffix {
  color: #e10600;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.raceweek-countdown-flag {
  width: 44rpx;
  height: 30rpx;
  border-radius: 4rpx;
}

.raceweek-countdown-flag-only {
  width: 112rpx;
  height: 78rpx;
  border-radius: 10rpx;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.28);
}

.raceweek-countdown-clock {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
}

.raceweek-countdown-clock .raceweek-countdown-seg + .raceweek-countdown-seg {
  margin-left: 14rpx;
}

.raceweek-countdown-seg {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
}

.raceweek-countdown-seg .raceweek-countdown-num + .raceweek-countdown-unit {
  margin-left: 10rpx;
}

.raceweek-countdown-num {
  font-size: 76rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.96);
  line-height: 76rpx;
  font-family: Formula1, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

.raceweek-countdown-unit {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.66);
  line-height: 30rpx;
  letter-spacing: 1rpx;
}

.quali-panel {
  margin-top: 8rpx;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.22);
}

.live-standings-panel {
  margin-top: 0;
}

.live-standings-wrap {
  position: relative;
  z-index: 4;
  margin-top: 16rpx;
  margin-bottom: 14rpx;
}

.live-standings-wrap-sticky {
  position: sticky;
}

.live-session-card {
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(14, 14, 18, 0.96) 0%, rgba(5, 5, 8, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.32);
}

.raceweek-live-card {
  margin-top: 0;
  margin-bottom: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.quali-panel-header {
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.live-session-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 84rpx;
}

.live-session-title-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.live-session-title-group .live-session-title + .live-session-subtitle {
  margin-top: 4rpx;
}

.live-session-title {
  color: #e10600;
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.live-session-title-compact {
  font-size: 28rpx;
  line-height: 32rpx;
  letter-spacing: 0;
}

.live-session-subtitle {
  color: #e10600;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.live-session-toggle {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.live-session-login-hint {
  color: rgba(255, 255, 255, 0.72);
  font-size: 18rpx;
  line-height: 1.2;
  text-align: right;
}

.raceweek-live-body {
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  background: rgba(10, 12, 18, 0.98);
  padding-bottom: 14rpx;
}

.raceweek-countdown-pressed {
  opacity: 0.92;
}

.quali-panel-title {
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 1rpx;
}

.quali-panel-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.quali-panel-body {
  height: 0;
  opacity: 0;
  overflow: hidden;
  transition: height 220ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease-out;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.quali-panel-body-open {
  height: 460rpx;
  opacity: 1;
}

.quali-panel-body-static {
  opacity: 1;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.welcome {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #000000;
}

.welcome-image {
  width: 100%;
  height: 100%;
}

.welcome-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.72) 100%);
}

.welcome-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 2rpx;
}

.press-preview-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9997;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.18) 0, rgba(225, 6, 0, 0) 30%),
    rgba(0, 0, 0, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  opacity: 0;
  transition: opacity 160ms ease-out;
}

.press-preview-overlay-active {
  opacity: 1;
}

.press-preview {
  width: 100%;
  max-width: 680rpx;
  position: relative;
  transform: translate3d(0, 22rpx, 0) scale(0.965);
  opacity: 0;
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease-out;
  will-change: transform, opacity;
}

.press-preview-active {
  transform: translate3d(0, 0, 0) scale(1);
  opacity: 1;
}

.press-preview-close {
  position: absolute;
  right: 8rpx;
  top: -70rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: rgba(10, 10, 14, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 36rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.24);
}

.press-preview-card {
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: linear-gradient(180deg, rgba(16, 16, 22, 0.98) 0%, rgba(7, 7, 10, 1) 100%);
  box-shadow: 0 28rpx 70rpx rgba(0, 0, 0, 0.4);
}

.press-preview-pressed {
  opacity: 0.94;
  transform: scale(0.99);
}

.press-preview-cover-wrap {
  width: 100%;
  height: 360rpx;
  background: #0a0a0a;
  position: relative;
}

.press-preview-cover {
  width: 100%;
  height: 100%;
}

.press-preview-cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(180deg, rgba(225, 6, 0, 0.16) 0%, rgba(225, 6, 0, 0.04) 24%, rgba(0, 0, 0, 0.2) 58%, rgba(0, 0, 0, 0.72) 100%);
}

.press-preview-body {
  padding: 24rpx 24rpx 26rpx;
}

.press-preview-title {
  font-weight: 800;
  font-size: 38rpx;
  line-height: 52rpx;
  color: rgba(255, 255, 255, 0.98);
}

.press-preview-summary {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 42rpx;
  height: 168rpx;
  overflow: hidden;
}

.press-preview-meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.press-preview-meta .press-preview-tag + .press-preview-dot,
.press-preview-meta .press-preview-dot + .press-preview-time {
  margin-left: 10rpx;
}

.press-preview-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.2);
  background: rgba(225, 6, 0, 0.12);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.press-preview-dot {
  color: rgba(255, 255, 255, 0.5);
}

.press-preview-time {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

@keyframes newsCardJiggle {
  0% {
    transform: translateY(0) scale(0.994);
    box-shadow: 0 16rpx 34rpx rgba(225, 6, 0, 0.06);
  }
  50% {
    transform: translateY(-4rpx) scale(1);
    box-shadow: 0 22rpx 46rpx rgba(225, 6, 0, 0.12);
  }
  100% {
    transform: translateY(0) scale(0.994);
    box-shadow: 0 16rpx 34rpx rgba(225, 6, 0, 0.06);
  }
}

.news-card-jiggle {
  transform-origin: 50% 50%;
  animation: newsCardJiggle 420ms ease-in-out infinite;
}

.hero-swiper {
  height: 360rpx;
  margin-top: 10rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 2;
}

.hero-banner {
  position: relative;
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #050507;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transform: translateY(-4rpx);
  box-shadow: 0 24rpx 54rpx rgba(0, 0, 0, 0.32);
}

.hero-banner-pressed {
  border-radius: 24rpx;
  overflow: hidden;
  opacity: 0.92;
}

.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background:
    linear-gradient(180deg, rgba(225, 6, 0, 0.2) 0%, rgba(225, 6, 0, 0.08) 26%, rgba(0, 0, 0, 0.3) 52%, rgba(0, 0, 0, 0.88) 100%);
}

.hero-content {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
}

.hero-title {
  font-weight: 800;
  font-size: 42rpx;
  line-height: 56rpx;
  letter-spacing: 0.5rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.38);
}

.hero-meta {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hero-meta .hero-tag + .hero-dot,
.hero-meta .hero-dot + .hero-time {
  margin-left: 10rpx;
}

.hero-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.22);
  background: rgba(225, 6, 0, 0.14);
  color: rgba(255, 255, 255, 0.94);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.load-more {
  padding: 22rpx 0 calc(36rpx + env(safe-area-inset-bottom));
  text-align: center;
  color: rgba(255, 255, 255, 0.55);
  font-size: 30rpx;
  letter-spacing: 10rpx;
}

.load-more-dot {
  display: inline-block;
  width: 12rpx;
  animation: loadMoreDots 900ms infinite ease-in-out;
  opacity: 0.25;
}

.dot2 {
  animation-delay: 150ms;
}

.dot3 {
  animation-delay: 300ms;
}

.load-more-end {
  padding: 26rpx 0 calc(44rpx + env(safe-area-inset-bottom));
  font-size: 24rpx;
  letter-spacing: 0;
}

@keyframes loadMoreDots {
  0%,
  80%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

.hero-dot {
  color: rgba(255, 255, 255, 0.6);
}

.hero-time {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-card {
  margin-bottom: 16rpx;
}

.news-card {
  position: relative;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  overflow: hidden;
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.18);
}

.news-card-text-only {
  padding: 24rpx 24rpx 22rpx 30rpx;
  border-radius: 20rpx;
  border-color: rgba(255, 255, 255, 0.08);
  background:
    linear-gradient(180deg, rgba(14, 14, 19, 0.98) 0%, rgba(8, 8, 12, 1) 100%);
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.18);
}

.news-card-text-only .news-body {
  position: relative;
  z-index: 1;
}

.news-card-glow {
  display: none;
}

.news-card-accent {
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(225, 6, 0, 0.75);
}

.news-card-pattern {
  display: none;
}

.news-card-with-cover {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.news-cover-wrap {
  width: 188rpx;
  height: 144rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  overflow: hidden;
  background: #0a0a0a;
}

.news-cover {
  width: 100%;
  height: 100%;
}

.news-body {
  flex: 1;
  min-width: 0;
}

.news-card-with-cover .news-title {
  font-size: 32rpx;
  line-height: 44rpx;
  height: 88rpx;
  overflow: hidden;
}

.news-card-with-cover .news-summary {
  margin-top: 8rpx;
  line-height: 38rpx;
  height: 76rpx;
  overflow: hidden;
}

.news-card-with-cover .news-meta {
  margin-top: 10rpx;
}

.news-card-text-only .news-title {
  font-size: 35rpx;
  line-height: 48rpx;
  font-weight: 800;
  letter-spacing: 0;
  height: 144rpx;
  overflow: hidden;
}

.news-summary-text-only {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.66);
  line-height: 38rpx;
  height: 76rpx;
  overflow: hidden;
}

.news-meta-text-only {
  margin-top: 14rpx;
}

.news-card-promoted {
  animation: prefPromoteIn 520ms cubic-bezier(0.22, 1, 0.36, 1);
  border-color: rgba(225, 6, 0, 0.2);
  box-shadow: 0 18rpx 40rpx rgba(225, 6, 0, 0.08);
}

.news-hit-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  opacity: 0.95;
  border-top-left-radius: 18rpx;
  border-bottom-left-radius: 18rpx;
}

.pref-move-overlay {
  position: fixed;
  z-index: 9998;
  pointer-events: none;
  will-change: transform;
}

.news-card-pressed {
  border-radius: 18rpx;
  overflow: hidden;
  opacity: 0.92;
}

@keyframes prefPromoteIn {
  0% {
    transform: translateY(18rpx);
    opacity: 0.2;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.news-title {
  font-weight: 700;
  font-size: 34rpx;
  line-height: 48rpx;
  color: rgba(255, 255, 255, 0.96);
}

.news-summary {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 40rpx;
}

.news-meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.news-meta .news-tag + .news-dot,
.news-meta .news-dot + .news-time {
  margin-left: 10rpx;
}

.news-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

.news-dot {
  color: rgba(255, 255, 255, 0.5);
}

.news-time {
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
}

.status {
  margin: 12rpx 0 18rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(7, 7, 12, 0.82);
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.status-error {
  color: rgba(255, 120, 120, 0.9);
  border-color: rgba(255, 120, 120, 0.25);
}
