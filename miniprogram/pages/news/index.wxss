.news-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.news-card {
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.news-title {
  font-weight: 700;
  font-size: 32rpx;
  line-height: 44rpx;
}

.news-summary {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 42rpx;
}

.news-meta {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.news-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.news-dot {
  color: rgba(255, 255, 255, 0.5);
}

.news-time {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}
