.news-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.welcome {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #000000;
}

.welcome-image {
  width: 100%;
  height: 100%;
}

.welcome-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.72) 100%);
}

.welcome-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 2rpx;
}

.hero-swiper {
  height: 280rpx;
  margin-top: 6rpx;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 2;
}

.hero-banner {
  position: relative;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  transform: translateY(-6rpx);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.65);
}

.hero-banner-pressed {
  border-radius: 20rpx;
  overflow: hidden;
  opacity: 0.92;
}

.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.82) 100%);
}

.hero-content {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
}

.hero-title {
  font-weight: 800;
  font-size: 36rpx;
  line-height: 50rpx;
}

.hero-meta {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.hero-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.hero-dot {
  color: rgba(255, 255, 255, 0.6);
}

.hero-time {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.hero-card {
  margin-bottom: 16rpx;
}

.news-card {
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  background: #000000;
  overflow: hidden;
}

.news-card-promoted {
  animation: prefPromoteIn 520ms cubic-bezier(0.22, 1, 0.36, 1);
  border-color: rgba(255, 255, 255, 0.22);
}

.pref-move-overlay {
  position: fixed;
  z-index: 9998;
  pointer-events: none;
  will-change: transform;
}

.news-card-pressed {
  border-radius: 16rpx;
  overflow: hidden;
  opacity: 0.92;
}

@keyframes prefPromoteIn {
  0% {
    transform: translateY(18rpx);
    opacity: 0.2;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.news-title {
  font-weight: 700;
  font-size: 32rpx;
  line-height: 44rpx;
}

.news-summary {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 42rpx;
}

.news-meta {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.news-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.news-dot {
  color: rgba(255, 255, 255, 0.5);
}

.news-time {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.status {
  margin: 8rpx 0 12rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.65);
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.status-error {
  color: rgba(255, 120, 120, 0.9);
  border-color: rgba(255, 120, 120, 0.25);
}
