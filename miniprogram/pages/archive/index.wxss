.page-root {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: transparent;
}

.page-scroll {
  width: 100%;
  height: calc(100vh - 200rpx);
  min-height: 0;
}

.page {
  width: 100%;
  min-height: 100%;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.14) 0, rgba(225, 6, 0, 0) 32%),
    linear-gradient(180deg, #15151e 0%, #101018 56%, #09090f 100%);
}

.header {
  width: 100%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.title {
  color: #ffffff;
  font-size: 56rpx;
  line-height: 68rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
}

.subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 26rpx;
  line-height: 36rpx;
  letter-spacing: 1.2rpx;
}

.archive-overview {
  width: 100%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.season-picker-wrap {
  width: 100%;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: flex-start;
  box-sizing: border-box;
}

.season-picker {
  flex: 0 0 auto;
  max-width: 100%;
  display: flex;
  justify-content: flex-start;
}

.season-pill {
  max-width: 520rpx;
  display: inline-flex;
  align-items: center;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(7, 7, 12, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.18);
}

.season-text {
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.season-arrow {
  margin-left: 10rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
}

.overview-card {
  width: calc((100% - 16rpx) / 2);
  min-height: 164rpx;
  padding: 20rpx 20rpx 22rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(14, 14, 18, 0.94) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.overview-card-wide {
  width: 100%;
  min-height: 184rpx;
  margin-bottom: 16rpx;
  background:
    linear-gradient(180deg, rgba(225, 6, 0, 0.14) 0%, rgba(20, 10, 12, 0.3) 34%, rgba(7, 7, 10, 0.98) 100%);
}

.overview-card-odd {
  margin-right: 16rpx;
}

.overview-kicker {
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
  letter-spacing: 1.5rpx;
}

.overview-main {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 900;
}

.overview-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.overview-value {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.overview-value-compact {
  font-size: 28rpx;
  line-height: 38rpx;
  font-family: inherit;
}

.timeline {
  width: 100%;
  box-sizing: border-box;
}

.timeline .timeline-item + .timeline-item {
  margin-top: 20rpx;
}

.timeline-item {
  position: relative;
  width: 100%;
  min-height: 188rpx;
  padding-left: 128rpx;
  box-sizing: border-box;
}

.timeline-gutter {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  box-sizing: border-box;
}

.timeline-date {
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
  letter-spacing: 1rpx;
  line-height: 28rpx;
}

.timeline-dot {
  width: 14rpx;
  height: 14rpx;
  margin: 12rpx 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.04);
  flex: none;
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  min-height: 72rpx;
  background: rgba(255, 255, 255, 0.12);
}

.timeline-content {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.timeline-content-featured .archive-card {
  border-color: rgba(225, 6, 0, 0.16);
  box-shadow: 0 20rpx 44rpx rgba(225, 6, 0, 0.08);
}

.archive-card {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}

.archive-thumb-wrap {
  position: relative;
  width: 100%;
  height: 188rpx;
  background: rgba(255, 255, 255, 0.02);
}

.archive-thumb {
  width: 100%;
  height: 100%;
}

.archive-thumb-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.08) 0%, rgba(0, 0, 0, 0.2) 56%, rgba(0, 0, 0, 0) 100%);
}

.archive-body {
  width: 100%;
  padding: 22rpx 22rpx 24rpx;
  box-sizing: border-box;
}

.archive-top {
  width: 100%;
  display: flex;
  align-items: center;
}

.archive-round {
  color: #e10600;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1.5rpx;
}

.archive-badge {
  margin-left: auto;
  min-width: 92rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.94);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.2);
  background: rgba(225, 6, 0, 0.14);
  box-sizing: border-box;
}

.archive-name {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.96);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.archive-date {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
}

.archive-results {
  margin-top: 18rpx;
}

.archive-results .archive-result-row + .archive-result-row {
  margin-top: 12rpx;
}

.archive-result-row {
  width: 100%;
  min-height: 36rpx;
  display: flex;
  align-items: center;
}

.archive-result-key {
  color: rgba(255, 255, 255, 0.54);
  font-size: 22rpx;
}

.archive-result-value {
  margin-left: auto;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
  text-align: right;
}
