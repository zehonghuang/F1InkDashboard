<view class="page has-tabbar">
  <view class="header" style="padding-top: calc({{ statusBarHeight }}px + 12rpx);">
    <view class="title">F1 数据分析</view>
    <view class="subtitle">Telemetry • Analysis • Archive</view>
  </view>

  <picker mode="selector" range="{{seasonOptions}}" value="{{seasonIndex}}" bindchange="onSeasonChange">
    <view class="season-picker">
      <view class="season-pill">
        <text class="season-text">{{seasonOptions[seasonIndex]}}</text>
        <text class="season-arrow">▼</text>
      </view>
    </view>
  </picker>

  <view class="timeline">
    <block wx:for="{{races}}" wx:key="id">
      <view class="timeline-item" bindtap="onRaceTap" data-id="{{item.id}}" data-name="{{item.name}}" data-round="{{item.round}}">
        <view class="timeline-gutter">
          <view class="timeline-date">{{item.dateShort}}</view>
          <view class="timeline-dot" />
          <view class="timeline-line" wx:if="{{index !== races.length - 1}}" />
        </view>
        <view class="timeline-content">
          <race-card i-class="timeline-card" thumb="{{item.thumb}}" fallbackThumb="{{item.thumbFallback}}" title="{{item.name}}" extra="{{item.roundText}}">
            <view slot="content">
              <view class="race-kv">分站冠军：{{item.winner}}</view>
              <view class="race-kv">正赛最快圈：{{item.fastestLap}}</view>
            </view>
          </race-card>
        </view>
      </view>
    </block>
  </view>
</view>
