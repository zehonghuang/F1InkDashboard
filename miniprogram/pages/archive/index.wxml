<view class="page has-tabbar">
  <view class="header" style="padding-top: calc({{ statusBarHeight }}px + 12rpx);">
    <view class="title">T O N I C  F 1  数 据 分 析</view>
    <view class="subtitle">Telemetry • Analysis • Archive</view>
  </view>

  <picker mode="selector" range="{{seasonOptions}}" value="{{seasonIndex}}" bindchange="onSeasonChange">
    <view class="season-picker">
      <view class="season-pill">
        <text class="season-text">{{seasonOptions[seasonIndex]}}</text>
        <text class="season-arrow">▼</text>
      </view>
    </view>
  </picker>

  <view class="race-list">
    <block wx:for="{{races}}" wx:key="id">
      <view class="race-card" bindtap="onRaceTap" data-id="{{item.id}}" data-name="{{item.name}}" data-round="{{item.round}}">
        <race-card thumb="{{item.thumb}}" fallbackThumb="{{item.thumbFallback}}" title="{{item.name}}" extra="{{item.date}}">
          <view slot="content">
            <view class="race-kv">分站冠军：{{item.winner}}</view>
            <view class="race-kv">正赛最快圈：{{item.fastestLap}}</view>
          </view>
        </race-card>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section-title">🔍 快速检索</view>
    <view class="section-desc">- 按赛道或特定日期查询</view>
    <input class="input" value="{{query}}" placeholder="例如：摩纳哥 / 05.24" placeholder-class="input-placeholder" bindinput="onQueryInput" />
    <view class="spacer" />
    <button class="btn" bindtap="onSearch">查询</button>
  </view>
</view>
