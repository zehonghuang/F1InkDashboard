<view class="page">
  <view class="header">
    <view class="title">T O N I C&nbsp;&nbsp;F 1&nbsp;&nbsp;数 据 分 析</view>
    <view class="subtitle">Telemetry • Analysis • Archive</view>
  </view>

  <picker mode="selector" range="{{seasonOptions}}" value="{{seasonIndex}}" bindchange="onSeasonChange">
    <view class="season-picker">
      <i-cell title="📂 遥测数据归档" value="{{seasonOptions[seasonIndex]}}" is-link />
    </view>
  </picker>

  <view class="race-list">
    <block wx:for="{{races}}" wx:key="id">
      <view class="race-card" bindtap="onRaceTap" data-id="{{item.id}}" data-name="{{item.name}}">
        <race-card thumb="{{item.thumb}}" title="{{item.name}}" extra="{{item.date}}">
          <view slot="content">
            <view class="race-kv">分站冠军：{{item.winner}}</view>
            <view class="race-kv">正赛最快圈：{{item.fastestLap}}</view>
          </view>
        </race-card>
      </view>
    </block>
  </view>

  <i-divider />

  <i-panel title="⚖️ 全局性能对比">
    <view class="panel-body">
      <view class="panel-desc">- 跨分站/多车手脚法对齐</view>
      <i-button type="primary" bindtap="onGoCompare">进入对比</i-button>
    </view>
  </i-panel>

  <i-divider />

  <i-panel title="🔍 快速检索">
    <view class="panel-body">
      <view class="panel-desc">- 按赛道或特定日期查询</view>
      <i-input value="{{query}}" placeholder="例如：摩纳哥 / 05.24" bindchange="onQueryChange" />
      <view class="spacer" />
      <i-button bindtap="onSearch">查询</i-button>
    </view>
  </i-panel>
</view>
