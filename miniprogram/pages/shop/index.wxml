<view class="page">
  <view class="hero-card">
    <view class="hero-eyebrow">WECHAT STORE</view>
    <view class="title">{{i18n.shop.pageTitle}}</view>
    <view class="subtitle">{{i18n.shop.connected}}</view>
    <view wx:if="{{storeAppId}}" class="meta-row">
      <view class="meta-label">{{i18n.shop.appIdLabel}}</view>
      <view class="meta-value">{{storeAppId}}</view>
    </view>
    <button class="open-btn" bindtap="onTapOpenStore">{{i18n.shop.openStore}}</button>
  </view>

  <view class="info-card">
    <view class="info-title">{{i18n.shop.howItWorksTitle}}</view>
    <view class="info-text">{{i18n.shop.howItWorksDesc}}</view>
  </view>

  <view class="info-card">
    <view class="info-title">{{i18n.shop.tipTitle}}</view>
    <view class="info-text">{{i18n.shop.tipDesc}}</view>
  </view>
</view>

