.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
  background: #000000;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub {
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-right {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.price {
  font-weight: 900;
  color: rgba(255, 255, 255, 0.9);
}

.chev {
  color: rgba(255, 255, 255, 0.45);
  font-size: 34rpx;
  line-height: 1;
}

.empty {
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  padding: 12rpx 6rpx;
}

