.hero-card,
.info-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  background: #000000;
}

.info-card {
  margin-top: 16rpx;
}

.hero-eyebrow {
  color: #ff5252;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 900;
}

.subtitle {
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  line-height: 1.6;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
}

.meta-label {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

.meta-value {
  font-family: monospace;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.open-btn {
  margin-top: 8rpx;
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff5a36, #ff2a68);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.open-btn::after {
  border: none;
}

.info-title {
  font-size: 28rpx;
  font-weight: 800;
}

.info-text {
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  line-height: 1.7;
}

.empty {
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  padding: 12rpx 6rpx;
}

