.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding-top: 0;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(7, 7, 12, 0.96);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.36);
  pointer-events: auto;
  -webkit-user-select: none;
  user-select: none;
}

.tabbar-inner {
  height: 104rpx;
  padding: 8rpx 16rpx 0;
  box-sizing: border-box;
  pointer-events: auto;
}

.tabbar-track {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: row;
}

.tabbar-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  transition: transform 120ms ease;
}

.icon-wrap {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  transition: transform 120ms ease, background-color 120ms ease, box-shadow 120ms ease;
}

.tabbar-item.is-selected .icon-wrap {
  background: rgba(225, 6, 0, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(225, 6, 0, 0.24);
}

.tabbar-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  color: rgba(255, 255, 255, 0.56);
  letter-spacing: 1rpx;
  transition: color 120ms ease;
}

.tabbar-item.is-selected .tabbar-label {
  color: rgba(255, 255, 255, 0.94);
}

.tabbar-item.is-selected {
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.14) 0%, rgba(225, 6, 0, 0.06) 100%);
}

.tabbar-item--pressed .icon-wrap {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.92);
}

.tabbar-item--pressed {
  transform: scale(0.98);
}
