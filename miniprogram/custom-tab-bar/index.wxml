<view class="tabbar">
  <block wx:for="{{ list }}" wx:key="key">
    <view class="tabbar-item" bindtap="onTapItem" data-key="{{ item.key }}">
      <i-icon
        type="{{ item.icon }}"
        size="24"
        color="{{ selected === item.key ? '#ffffff' : 'rgba(255,255,255,0.55)' }}"
      />
    </view>
  </block>
</view>
