{
  "pages": [
    "pages/entry/index",
    "pages/news/index",
    "pages/archive/index",
    "pages/mine/index"
  ],
  "subPackages": [
    {
      "root": "packages/news-pkg",
      "name": "news-pkg",
      "pages": [
        "pages/news-detail/index"
      ]
    },
    {
      "root": "packages/race-pkg",
      "name": "race-pkg",
      "pages": [
        "pages/race-sessions/index",
        "pages/session-results/index",
        "pages/driver/index",
        "pages/tyre-intro/index",
        "pages/standings/index",
        "pages/live-timing/index"
      ]
    },
    {
      "root": "packages/shop-pkg",
      "name": "shop-pkg",
      "pages": [
        "pages/shop/index",
        "pages/shop-detail/index"
      ]
    },
    {
      "root": "packages/tools-pkg",
      "name": "tools-pkg",
      "pages": [
        "pages/image-crop/index",
        "pages/style-demo/index",
        "pages/compare/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/news/index": {
      "network": "all",
      "packages": ["news-pkg"]
    },
    "pages/archive/index": {
      "network": "all",
      "packages": ["race-pkg"]
    },
    "pages/mine/index": {
      "network": "all",
      "packages": ["race-pkg", "shop-pkg", "tools-pkg"]
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "window": {
    "navigationBarTitleText": "TONIC F1 Analytics",
    "navigationBarBackgroundColor": "#15151E",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#15151E",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "custom": true,
    "color": "#ffffff",
    "selectedColor": "#ffffff",
    "backgroundColor": "#15151E",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/news/index",
        "text": "资讯",
        "iconPath": "assets/tabbar/archive.png",
        "selectedIconPath": "assets/tabbar/archive_selected.png"
      },
      {
        "pagePath": "pages/archive/index",
        "text": "归档",
        "iconPath": "assets/tabbar/archive.png",
        "selectedIconPath": "assets/tabbar/archive_selected.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "assets/tabbar/mine.png",
        "selectedIconPath": "assets/tabbar/mine_selected.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json"
}
