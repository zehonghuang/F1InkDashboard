@import "../../../../styles/data-page.wxss";

.leaders {
  margin-bottom: 14rpx;
}

.leader-card {
  flex: 1;
}

.leader-card-main {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.leader-card-rank {
  color: #e10600;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.leader-card-body {
  min-width: 0;
}

.leader-card-name {
  color: rgba(255, 255, 255, 0.96);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.leader-card-sub {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.leader-card-points {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.leader-card-points-value {
  color: rgba(255, 255, 255, 0.98);
  font-size: 42rpx;
  line-height: 1;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.leader-card-points-unit {
  color: rgba(255, 255, 255, 0.54);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.standings-card {
  position: relative;
  gap: 14rpx;
  border-radius: 20rpx;
}

.card-accent {
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  opacity: 0.96;
}

.top-1 {
  border-color: rgba(255, 230, 160, 0.18);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.24);
}

.top-2 {
  border-color: rgba(235, 238, 244, 0.12);
}

.top-3 {
  border-color: rgba(214, 150, 108, 0.14);
}

.rank-col {
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.rank-badge {
  min-width: 60rpx;
  height: 60rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.top-1 .rank-badge {
  background: linear-gradient(180deg, rgba(255, 232, 168, 0.2) 0%, rgba(255, 232, 168, 0.08) 100%);
  color: #fff3cf;
}

.top-2 .rank-badge {
  background: linear-gradient(180deg, rgba(214, 221, 230, 0.16) 0%, rgba(214, 221, 230, 0.06) 100%);
  color: #eef1f6;
}

.top-3 .rank-badge {
  background: linear-gradient(180deg, rgba(214, 150, 108, 0.18) 0%, rgba(214, 150, 108, 0.06) 100%);
  color: #f4d3bd;
}

.card-left {
  width: 96rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.avatar-shell {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
}

.card-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.driver-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.driver {
  color: rgba(255, 255, 255, 0.96);
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.driver-no {
  flex: none;
  color: rgba(255, 255, 255, 0.54);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.team {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-row {
  margin-top: 4rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.progress-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
}

.progress-fill {
  height: 100%;
  min-width: 10rpx;
  border-radius: 999rpx;
}

.gap {
  flex: none;
  color: rgba(255, 255, 255, 0.48);
  font-size: 20rpx;
  letter-spacing: 0.5rpx;
}

.card-right {
  width: 98rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
}

.pts {
  color: rgba(255, 255, 255, 0.98);
  font-size: 40rpx;
  line-height: 1;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.pts-unit {
  color: rgba(255, 255, 255, 0.5);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}
