<view class="page has-tabbar">
  <view class="header">
    <view class="title">{{i18n.compare.title}}</view>
    <view class="subtitle">{{i18n.compare.subtitle}}</view>
  </view>

  <view class="section">
    <view class="section-title">{{i18n.compare.sectionDimension}}</view>
    <view class="item" bindtap="onPickMode">{{i18n.compare.byTrack}}</view>
    <view class="item-desc">{{i18n.compare.byTrackDesc}}</view>
    <view class="divider" />
    <view class="item" bindtap="onPickMode">{{i18n.compare.byDate}}</view>
    <view class="item-desc">{{i18n.compare.byDateDesc}}</view>
    <view class="divider" />
    <view class="item" bindtap="onPickMode">{{i18n.compare.byDriver}}</view>
    <view class="item-desc">{{i18n.compare.byDriverDesc}}</view>
  </view>

  <view class="section">
    <view class="section-title">{{i18n.compare.sectionHint}}</view>
    <view class="section-desc">{{i18n.compare.hintText}}</view>
    <button class="btn btn-primary" bindtap="onPickMode">{{i18n.compare.startCompare}}</button>
  </view>
</view>
