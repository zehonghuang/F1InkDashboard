.page-root {
  height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(92, 232, 144, 0.10) 0, rgba(92, 232, 144, 0) 40%),
    linear-gradient(180deg, #0e0e14 0%, #0a0a10 56%, #050509 100%);
  display: flex;
  flex-direction: column;
}

.status-bar {
  width: 100%;
  flex: none;
}

.nav {
  height: 88rpx;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 16rpx;
  box-sizing: border-box;
  flex: none;
  position: relative;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.nav-back-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.nav-back-bar {
  position: absolute;
  left: 0;
  width: 26rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.86);
}

.nav-back-bar-top {
  top: 9rpx;
  transform: rotate(-40deg);
  transform-origin: left center;
}

.nav-back-bar-bottom {
  bottom: 9rpx;
  transform: rotate(40deg);
  transform-origin: left center;
}

.nav-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.nav-placeholder {
  width: 80rpx;
  flex: none;
}

.page-scroll {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.hero-shell {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.hero-card {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 24rpx 26rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background:
    radial-gradient(circle at 88% 0%, rgba(92, 232, 144, 0.16) 0, rgba(92, 232, 144, 0) 38%),
    linear-gradient(180deg, rgba(14, 14, 20, 0.98) 0%, rgba(8, 8, 12, 0.985) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04),
    0 26rpx 64rpx rgba(0, 0, 0, 0.34);
}

.hero-head {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hero-avatar-shell {
  flex: none;
  margin-right: 18rpx;
}

.hero-avatar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 30% 28%, rgba(150, 244, 188, 0.96) 0%, rgba(92, 232, 144, 0.28) 18%, rgba(92, 232, 144, 0) 34%),
    linear-gradient(180deg, rgba(36, 183, 95, 0.96) 0%, rgba(15, 142, 69, 1) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.22),
    0 14rpx 28rpx rgba(8, 92, 42, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hero-avatar-corner {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #ffffff;
}

.hero-avatar-corner-tl {
  left: 20rpx;
  top: 20rpx;
  border-right: none;
  border-bottom: none;
}

.hero-avatar-corner-tr {
  right: 20rpx;
  top: 20rpx;
  border-left: none;
  border-bottom: none;
}

.hero-avatar-corner-bl {
  left: 20rpx;
  bottom: 20rpx;
  border-right: none;
  border-top: none;
}

.hero-avatar-corner-br {
  right: 20rpx;
  bottom: 20rpx;
  border-left: none;
  border-top: none;
}

.hero-avatar-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin-left: -11rpx;
  margin-top: -11rpx;
  border-radius: 6rpx;
  background: #ffffff;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-name {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.54);
  font-size: 22rpx;
  line-height: 32rpx;
}

.qr-shell {
  position: relative;
  margin-top: 30rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx;
  min-height: 580rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(24, 24, 32, 0.96) 0%, rgba(12, 12, 18, 0.98) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.qr {
  width: 100%;
  height: 580rpx;
  display: block;
  transition: opacity 280ms ease-out;
}

.qr-hidden {
  opacity: 0;
}

.qr-visible {
  opacity: 1;
}

.qr-state {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.54);
  font-size: 24rpx;
  line-height: 34rpx;
}

.qr-fake {
  min-height: 580rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 18rpx;
  box-sizing: border-box;
}

.qr-board {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.18);
}

.qr-cell {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 3rpx;
  background: #111111;
}

.qr-fake-note {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  line-height: 28rpx;
}

.tip {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}
