/* Shared visual foundation for data-heavy pages */

.dp-page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(225, 6, 0, 0.14) 0, rgba(225, 6, 0, 0) 32%),
    linear-gradient(180deg, #15151e 0%, #101018 56%, #09090f 100%);
}

.dp-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.dp-tabs {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  margin: 14rpx 0 16rpx 0;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 7, 12, 0.88);
}

.dp-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.62);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.dp-tab-active {
  background: linear-gradient(180deg, rgba(225, 6, 0, 0.2) 0%, rgba(225, 6, 0, 0.12) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(225, 6, 0, 0.22);
  color: #ffffff;
}

.dp-overview-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.dp-overview-card {
  width: calc((100% - 16rpx) / 2);
  min-height: 164rpx;
  box-sizing: border-box;
  padding: 20rpx 20rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(14, 14, 18, 0.94) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.dp-overview-card-wide {
  width: 100%;
  min-height: 184rpx;
  background:
    linear-gradient(180deg, rgba(225, 6, 0, 0.14) 0%, rgba(20, 10, 12, 0.3) 34%, rgba(7, 7, 10, 0.98) 100%);
}

.dp-overview-kicker {
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
  letter-spacing: 1.5rpx;
}

.dp-overview-main {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 900;
}

.dp-overview-value {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.98);
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 900;
  font-family: Formula1, sans-serif;
}

.dp-overview-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.dp-panel {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.94) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.dp-panel-title {
  color: rgba(255, 255, 255, 0.96);
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.dp-panel-desc {
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  margin-bottom: 18rpx;
}

.dp-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(12, 12, 16, 0.96) 0%, rgba(7, 7, 10, 0.98) 100%);
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.18);
}

.dp-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: rgba(7, 7, 12, 0.88);
}

.dp-toolbar-text {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dp-toolbar-btn {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(225, 6, 0, 0.24);
  background: rgba(225, 6, 0, 0.14);
  color: #ffffff;
  font-weight: 700;
}

.dp-chart-shell {
  min-height: 520rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(10, 10, 14, 0.98) 0%, rgba(5, 5, 8, 1) 100%);
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.22);
}

.dp-hint-pill {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  margin-bottom: 16rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(7, 7, 12, 0.76);
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
}

.dp-error-panel {
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 120, 120, 0.2);
  background: rgba(64, 8, 8, 0.24);
  color: rgba(255, 120, 120, 0.9);
  font-size: 24rpx;
}

.dp-dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 900;
}

.dp-dialog {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 120rpx;
  bottom: 120rpx;
  background: #0b0b10;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  z-index: 901;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.dp-dialog-header {
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.dp-dialog-title {
  font-weight: 900;
  letter-spacing: 1rpx;
}

.dp-dialog-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.dp-dialog-btn {
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-weight: 700;
}

.dp-dialog-btn-primary {
  background: rgba(225, 6, 0, 0.16);
  border-color: rgba(225, 6, 0, 0.24);
}

.dp-dialog-list {
  flex: 1;
  overflow: auto;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
