@font-face {
  font-family: Formula1;
  src: url("assets/fonts/Formula1-Bold.ttf") format("truetype");
}

page {
  background: #15151E;
  color: #ffffff;
  font-size: 28rpx;
}

.page {
  padding: 24rpx;
}

.header {
  padding: 12rpx 0 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: normal;
  letter-spacing: 2rpx;
  font-family: Formula1, sans-serif;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}
